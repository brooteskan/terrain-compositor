#pragma once
#include "VueTerrainOverlapInputs.azsli"
#include <TerrainCompositor/TerrainOverlapWeights.azsli>
#include <TerrainCompositor/TerrainOverlapWeights16.azsli>
option bool o_terrainHeightFp16 = false;
option bool o_terrainOverlapPages = false;
[[range(0, 4)]]
option int o_terrainContributorControl = 0;
#include "VueTerrainContributorTiles.azsli"

// Owned query fields use the extent emitted by the same publisher. Legacy or
// manually authored materials keep the dynamic-dimension path by default.
option bool o_terrainOverlapFixedHeightExtent = false;
// Source count participates in native pipeline specialization, like precision.
// Fixed loop bounds also allow inactive sources to be removed by the compiler.
[[range(0, 4)]]
option int o_terrainOverlapSourceCount = 0;

// Frozen experiment key; ordinary publications retain key zero and fallback.
bool VueContributorReady(const MaterialParameters params)
{
    return o_terrainHeightFp16 && o_terrainOverlapFixedHeightExtent && o_terrainOverlapSourceCount == 2 &&
        params.m_vueContributorKey == VueContributorKey && params.m_vueOverlapWidth == 10.0 &&
        params.m_vueGroundHeight == 0.0 && params.m_vueGroundTolerance == 0.001;
}

// Preserve the StandardPBR channels that overlap does not replace. The
// publisher accepts opaque baked PBR without emissive/clear coat. Retain the
// complete path if those features are enabled through a live material edit.
Surface VueOverlapSurfaceBase(VsOutput IN, VsSystemValues SV, PixelGeometryData geoData,
    const MaterialParameters params, float4 uvDxDy)
{
    if (o_emissiveEnabled || o_clearCoat_enabled)
        return EvaluateSurface_StandardPBR(IN, SV, geoData, params, uvDxDy, true);
    Surface surface = (Surface)0;
    surface.position = geoData.positionWS;
    surface.vertexNormal = geoData.vertexNormal;
    surface.lightingChannels = GetLightingChannelMask(SV);
    surface.alpha = GetAlphaAndClip(params, geoData.uvs, uvDxDy, true);
    surface.specularOcclusion = GetOcclusionInput(GetMaterialTexture(params.m_specularOcclusionMap),
        GetMaterialTextureSampler(), geoData.uvs[params.m_specularOcclusionMapUvIndex],
        real(params.m_specularOcclusionFactor), o_specularOcclusion_useTexture, uvDxDy, true);
    surface.opacityAffectsSpecularFactor = real(params.m_opacityAffectsSpecularFactor);
    return surface;
}

// Fixed sixteen-page edit-time cache. Each physical page has a one-texel
// gutter; absent pages, invalid coverage, unsupported precision/features and
// unresolved footprints retain the exact existing overlap shader below.
bool VueTryOverlapPages(VsOutput IN, VsSystemValues SV, PixelGeometryData geoData,
    const MaterialParameters params, float4 uvDxDy, float4 worldDerivatives, out Surface surface)
{
    if (!o_terrainOverlapPages || !o_terrainHeightFp16 || o_terrainOverlapSourceCount != 2 ||
        o_emissiveEnabled || o_clearCoat_enabled || params.m_vueOverlapWidth <= 0 ||
        params.m_vuePagesChannel0 < 0 || params.m_vuePagesChannel1 < 0 ||
        params.m_vuePagesChannel2 < 0 || params.m_vuePagesChannel3 < 0 ||
        any(params.m_vuePagesExtent <= 0)) return false;
    float2 uv = (geoData.positionWS.xy - params.m_vuePagesLow) / params.m_vuePagesExtent;
    if (any(uv <= 0) || any(uv >= 1)) return false;
    float pitch = params.m_vuePagesSize * 0.25;
    float core = pitch - 2.0;
    float2 virtualPixel = uv * (4.0 * core);
    float2 dx = worldDerivatives.xy / params.m_vuePagesExtent * (4.0 * core);
    float2 dy = worldDerivatives.zw / params.m_vuePagesExtent * (4.0 * core);
    // This prototype has no mip chain. Magnification uses the baked texel
    // resolution (appearance is measured); reject minification beyond the gutter.
    float footprint = max(length(dx), length(dy));
    if (!isfinite(footprint) || footprint > 1.5) return false;
    float2 page = floor(virtualPixel / core);
    float2 physicalUv = (page * pitch + frac(virtualPixel / core) * core + 1.0) / params.m_vuePagesSize;
    float4 validity = GetMaterialTexture(params.m_vuePagesChannel3).SampleLevel(GetMaterialTextureSampler(), physicalUv, 0);
    if (validity.y < 0.99999) return false;
    half4 colorSpec = half4(GetMaterialTexture(params.m_vuePagesChannel0).SampleLevel(GetMaterialTextureSampler(), physicalUv, 0));
    half4 normalRough = half4(GetMaterialTexture(params.m_vuePagesChannel1).SampleLevel(GetMaterialTextureSampler(), physicalUv, 0));
    half4 vertexMetal = half4(GetMaterialTexture(params.m_vuePagesChannel2).SampleLevel(GetMaterialTextureSampler(), physicalUv, 0));
    surface = VueOverlapSurfaceBase(IN, SV, geoData, params, uvDxDy);
    surface.SetAlbedoAndSpecularF0(colorSpec.rgb, colorSpec.a, vertexMetal.a);
    surface.normal = normalize(normalRough.xyz);
    surface.vertexNormal = normalize(vertexMetal.xyz);
    surface.roughnessLinear = normalRough.a;
    surface.CalculateRoughnessA();
    surface.diffuseAmbientOcclusion = half(validity.x);
    if (params.m_vuePagesDebug) surface.SetAlbedoAndSpecularF0(half3(0,1,0), half(0), half(0));
    return true;
}

struct VueOverlapQuery
{
    float2 uv;
    float height;
    float coverage;
};

float3 VueOverlapSafeNormal(float3 value, float3 fallback)
{
    float lengthSquared = dot(value, value);
    return lengthSquared > 1e-12 && all(isfinite(value)) ? value * rsqrt(lengthSquared) : fallback;
}

VueOverlapQuery VueQueryOverlap(VueOverlapSource source, float3 world, float width, float cutoff)
{
    VueOverlapQuery q = (VueOverlapQuery)0;
    q.uv = float2(dot(source.uvRow0, float3(world.xy, 1)), dot(source.uvRow1, float3(world.xy, 1)));
    if (source.heightMap < 0 || any(q.uv < 0) || any(q.uv > 1)) return q;
    uint w, h;
    if (o_terrainOverlapFixedHeightExtent)
    {
        w = h = VueOverlapHeightFieldSize;
    }
    else
    {
        GetMaterialTexture(source.heightMap).GetDimensions(w, h);
    }
    float2 texel = (q.uv * (float2(w, h) - 1) + 0.5) / float2(w, h);
    q.height = GetMaterialTexture(source.heightMap).SampleLevel(GetMaterialTextureSampler(), texel, 0).x *
        source.heightScaleOffset.x + source.heightScaleOffset.y;
    float2 distance = min(q.uv, 1.0 - q.uv) / max(float2(length(source.uvRow0.xy), length(source.uvRow1.xy)), 1e-8);
    q.coverage = q.height > cutoff ? TC_OverlapRamp(min(distance.x, distance.y), width) : 0;
    return q;
}

// Apply each source transform only when its material is sampled. The input
// derivatives were captured before contributor selection, so quad footprints
// remain identical without carrying four gradient vectors through height tests.
float4 VueOverlapDerivatives(VueOverlapSource source, float4 worldDerivatives)
{
    float2 dx = worldDerivatives.xy, dy = worldDerivatives.zw;
    return float4(dot(source.uvRow0.xy, dx), dot(source.uvRow1.xy, dx),
                  dot(source.uvRow0.xy, dy), dot(source.uvRow1.xy, dy));
}

half3 VueOverlapVertexNormal(VueOverlapSource s, float2 uv)
{
    if (s.normalField < 0) return half3(0, 0, 1);
    // Match VueSmoothNormal's one-read approximation instead of repeating a
    // four-read cubic reconstruction for every participating overlap source.
    float2 grid = max(s.gridSize, 2.0);
    uint width, height; GetMaterialTexture(s.normalField).GetDimensions(width, height);
    if (width < grid.x || height < grid.y) return half3(0, 0, 1);
    float2 texel = (saturate(uv) * (grid - 1.0) + 0.5) / float2(width, height);
    half3 n = half3(GetMaterialTexture(s.normalField).SampleLevel(GetMaterialTextureSampler(), texel, 0).xyz);
    // The generated field remains in baked model coordinates; preserve the
    // source instance's normal transform and the existing normalization.
    return normalize(half3(dot(half3(s.normalRow0),n),dot(half3(s.normalRow1),n),dot(half3(s.normalRow2),n)));
}

VueOverlapQuery VueQueryOverlap16(VueOverlapSource source, float3 world, float width, float cutoff)
{
    VueOverlapQuery q = (VueOverlapQuery)0;
    q.uv = float2(dot(source.uvRow0, float3(world.xy, 1)), dot(source.uvRow1, float3(world.xy, 1)));
    if (source.heightMap < 0 || any(q.uv < 0) || any(q.uv > 1)) return q;
    uint w, h;
    if (o_terrainOverlapFixedHeightExtent)
    {
        w = h = VueOverlapHeightFieldSize;
    }
    else
    {
        GetMaterialTexture(source.heightMap).GetDimensions(w, h);
    }
    float2 texel = (q.uv * (float2(w, h) - 1) + 0.5) / float2(w, h);
    half rawHeight = half(GetMaterialTexture(source.heightMap).SampleLevel(GetMaterialTextureSampler(), texel, 0).x);
    half heightScale = half(source.heightScaleOffset.x);
    half heightOffset = half(source.heightScaleOffset.y);
    half height = rawHeight * heightScale + heightOffset;
    q.height = float(height);
    float2 distance = min(q.uv, 1.0 - q.uv) / max(float2(length(source.uvRow0.xy), length(source.uvRow1.xy)), 1e-8);
    q.coverage = height > half(cutoff) ? float(TC_OverlapRamp16(half(min(distance.x, distance.y)), half(width))) : 0;
    return q;
}

half3 VueOverlapSafeNormal16(half3 value, half3 fallback)
{
    half lengthSquared = dot(value, value);
    return lengthSquared > half(0.00006103515625) && all(isfinite(value)) ? value * rsqrt(lengthSquared) : fallback;
}
// Necessary endpoint test only: all actual blends still use the original
// weight resolver, including its precision, normalization, and thresholds.
bool VueOverlapPairEndpoint32(float2 heights, float2 coverage, float width)
{
    if (!(width > 0) || !isfinite(width)) return true;
    coverage = saturate(coverage);
    if (any(coverage <= 0) || !all(isfinite(coverage)) || !all(isfinite(heights))) return true;
    return (coverage.x == 1.0 && TC_OverlapRamp(heights.x - heights.y, width) == 1.0) ||
           (coverage.y == 1.0 && TC_OverlapRamp(heights.y - heights.x, width) == 1.0);
}

// Necessary endpoint test only: all actual blends still use the original
// weight resolver, including its precision, normalization, and thresholds.
bool VueOverlapPairEndpoint16(half2 heights, half2 coverage, half width)
{
    if (!(width > 0) || !isfinite(width)) return true;
    coverage = saturate(coverage);
    if (any(coverage <= 0) || !all(isfinite(coverage)) || !all(isfinite(heights))) return true;
    return (coverage.x == 1.0h && TC_OverlapRamp16(heights.x - heights.y, width) == 1.0h) ||
           (coverage.y == 1.0h && TC_OverlapRamp16(heights.y - heights.x, width) == 1.0h);
}

// A pair needs both footprints. Reject missing footprints before either
// height read. Enable alongside the owned fixed-extent specialization; legacy
// materials retain the original query path for compatibility and A/B profiling.
// The query functions retain their original checks and arithmetic.
bool VueOverlapPairFootprints(const MaterialParameters params, float3 world)
{
    [unroll] for (uint i = 0; i < 2; ++i)
    {
        VueOverlapSource source = VueGetOverlapSource(i, params);
        float2 uv = float2(dot(source.uvRow0, float3(world.xy, 1)),
                          dot(source.uvRow1, float3(world.xy, 1)));
        if (source.heightMap < 0 || any(uv < 0) || any(uv > 1)) return false;
    }
    return true;
}

bool VueTryTerrainOverlap32(VsOutput IN, VsSystemValues SV, PixelGeometryData geoData,
    const MaterialParameters params, float4 uvDxDy, float4 worldDerivatives, out Surface surface)
{
    if (params.m_vueOverlapWidth <= 0 || o_terrainOverlapSourceCount < 2 || o_terrainOverlapSourceCount > 4) return false;
    if (o_terrainOverlapFixedHeightExtent && o_terrainOverlapSourceCount == 2 && !VueOverlapPairFootprints(params, geoData.positionWS)) return false;
    VueOverlapQuery queries[4];
    float4 heights = 0, coverage = 0;
    [unroll] for (uint i = 0; i < 4; ++i)
    {
        if (i >= o_terrainOverlapSourceCount) break;
        VueOverlapSource source = VueGetOverlapSource(i, params);
        queries[i] = VueQueryOverlap(source, geoData.positionWS, params.m_vueOverlapWidth,
            params.m_vueGroundHeight + max(params.m_vueGroundTolerance, 0.0));
        heights[i] = queries[i].height; coverage[i] = queries[i].coverage;
        // With two sources, either missing contributor makes a blend impossible.
        // Derivatives were captured before this varying exit.
        if (o_terrainOverlapSourceCount == 2 &&
            (coverage[i] <= 0 || !isfinite(heights[i]))) return false;
    }
    if (o_terrainOverlapSourceCount == 2 && VueOverlapPairEndpoint32(heights.xy, coverage.xy, float(params.m_vueOverlapWidth))) return false;
    float4 weights = TC_OverlapWeights(heights, coverage, o_terrainOverlapSourceCount, params.m_vueOverlapWidth, true);
    // Preserve the stock endpoint away from intersections. Both retained meshes
    // evaluate the identical set at a crossing, independent of raster winner.
    uint participants = 0;
    [unroll] for (uint k = 0; k < 4; ++k) if (k < o_terrainOverlapSourceCount && weights[k] > 0) ++participants;
    if (participants < 2) return false;
    // Exact pixel set: diagnostic A retains all contributor queries and weights.
    // Diagnostic B uses the same test for tiles not guaranteed to blend.
    if ((o_terrainContributorControl == 1 || o_terrainContributorControl == 2) && VueContributorReady(params)) discard;

    surface = VueOverlapSurfaceBase(IN, SV, geoData, params, uvDxDy);
    float3 color = 0;
    half3 normal = 0, vertexNormal = 0;
    float roughness = 0, metallic = 0, specular = 0, occlusion = 0;
    [unroll] for (uint j = 0; j < 4; ++j)
    {
        if (j >= o_terrainOverlapSourceCount || weights[j] <= 0) continue;
        VueOverlapSource s = VueGetOverlapSource(j, params); VueOverlapQuery q = queries[j];
        float4 derivatives = VueOverlapDerivatives(s, worldDerivatives);
        half3 n = VueOverlapVertexNormal(s, q.uv);
        half3 tangent = half3(s.tangent);
        half3 t = normalize(tangent - n * dot(tangent, n));
        half3 b = -normalize(cross(n, t)); // Imported UV0 has flipped V.
        float3 sampled = GetBaseColorInput(GetMaterialTexture(s.colorMap), GetMaterialTextureSampler(), q.uv,
            s.color.rgb, s.colorMap >= 0, derivatives, true);
        color += weights[j] * BlendBaseColor(sampled, s.color.rgb, s.colorFactor, TextureBlendMode::Multiply, s.colorMap >= 0);
        normal += half(weights[j]) * half3(GetNormalInputWS(GetMaterialTexture(s.normalMap), GetMaterialTextureSampler(), q.uv,
            false, false, true, n, t, b, CreateIdentity3x3_real(), s.normalMap >= 0, s.normalStrength, derivatives, true));
        vertexNormal += half(weights[j]) * n;
        roughness += weights[j] * s.roughness;
        metallic += weights[j] * s.metallic;
        specular += weights[j] * GetSpecularInput(GetMaterialTexture(s.specularMap), GetMaterialTextureSampler(), q.uv,
            s.specular, s.specularMap >= 0, derivatives, true);
        occlusion += weights[j] * GetOcclusionInput(GetMaterialTexture(s.occlusionMap), GetMaterialTextureSampler(), q.uv,
            s.occlusion, s.occlusionMap >= 0, derivatives, true);
    }
    surface.SetAlbedoAndSpecularF0(color, specular, metallic);
    surface.vertexNormal = VueOverlapSafeNormal16(vertexNormal, half3(surface.vertexNormal));
    surface.normal = VueOverlapSafeNormal16(normal, half3(surface.vertexNormal));
    surface.roughnessLinear = roughness; surface.CalculateRoughnessA();
    surface.diffuseAmbientOcclusion = occlusion;
    return true;
}
bool VueTryTerrainOverlap16(VsOutput IN, VsSystemValues SV, PixelGeometryData geoData,
    const MaterialParameters params, float4 uvDxDy, float4 worldDerivatives, out Surface surface)
{
    if (params.m_vueOverlapWidth <= 0 || o_terrainOverlapSourceCount < 2 || o_terrainOverlapSourceCount > 4) return false;
    if (o_terrainOverlapFixedHeightExtent && o_terrainOverlapSourceCount == 2 && !VueOverlapPairFootprints(params, geoData.positionWS)) return false;
    VueOverlapQuery queries[4];
    half4 heights = 0, coverage = 0;
    [unroll] for (uint i = 0; i < 4; ++i)
    {
        if (i >= o_terrainOverlapSourceCount) break;
        VueOverlapSource source = VueGetOverlapSource(i, params);
        queries[i] = VueQueryOverlap16(source, geoData.positionWS, params.m_vueOverlapWidth,
            params.m_vueGroundHeight + max(params.m_vueGroundTolerance, 0.0));
        heights[i] = queries[i].height; coverage[i] = queries[i].coverage;
        // With two sources, either missing contributor makes a blend impossible.
        // Derivatives were captured before this varying exit.
        if (o_terrainOverlapSourceCount == 2 &&
            (coverage[i] <= 0 || !isfinite(heights[i]))) return false;
    }
    if (o_terrainOverlapSourceCount == 2 && VueOverlapPairEndpoint16(heights.xy, coverage.xy, half(params.m_vueOverlapWidth))) return false;
    half4 weights = TC_OverlapWeights16(heights, coverage, o_terrainOverlapSourceCount, half(params.m_vueOverlapWidth), true);
    // Preserve the stock endpoint away from intersections. Both retained meshes
    // evaluate the identical set at a crossing, independent of raster winner.
    uint participants = 0;
    [unroll] for (uint k = 0; k < 4; ++k) if (k < o_terrainOverlapSourceCount && weights[k] > 0) ++participants;
    if (participants < 2) return false;
    // Exact pixel set: diagnostic A retains all contributor queries and weights.
    // Diagnostic B uses the same test for tiles not guaranteed to blend.
    if ((o_terrainContributorControl == 1 || o_terrainContributorControl == 2) && VueContributorReady(params)) discard;

    surface = VueOverlapSurfaceBase(IN, SV, geoData, params, uvDxDy);
    half3 color = 0, normal = 0, vertexNormal = 0;
    half roughness = 0, metallic = 0, specular = 0, occlusion = 0;
    [unroll] for (uint j = 0; j < 4; ++j)
    {
        if (j >= o_terrainOverlapSourceCount || weights[j] <= 0) continue;
        VueOverlapSource s = VueGetOverlapSource(j, params); VueOverlapQuery q = queries[j];
        float4 derivatives = VueOverlapDerivatives(s, worldDerivatives);
        half3 n = VueOverlapVertexNormal(s, q.uv);
        half3 tangent = half3(s.tangent);
        half3 t = normalize(tangent - n * dot(tangent, n));
        half3 b = -normalize(cross(n, t)); // Imported UV0 has flipped V.
        float3 sampled = GetBaseColorInput(GetMaterialTexture(s.colorMap), GetMaterialTextureSampler(), q.uv,
            s.color.rgb, s.colorMap >= 0, derivatives, true);
        color += weights[j] * half3(BlendBaseColor(sampled, s.color.rgb, s.colorFactor, TextureBlendMode::Multiply, s.colorMap >= 0));
        normal += weights[j] * half3(GetNormalInputWS(GetMaterialTexture(s.normalMap), GetMaterialTextureSampler(), q.uv,
            false, false, true, n, t, b, CreateIdentity3x3_real(), s.normalMap >= 0, s.normalStrength, derivatives, true));
        vertexNormal += weights[j] * n;
        roughness += weights[j] * half(s.roughness);
        metallic += weights[j] * half(s.metallic);
        specular += weights[j] * half(GetSpecularInput(GetMaterialTexture(s.specularMap), GetMaterialTextureSampler(), q.uv,
            s.specular, s.specularMap >= 0, derivatives, true));
        occlusion += weights[j] * half(GetOcclusionInput(GetMaterialTexture(s.occlusionMap), GetMaterialTextureSampler(), q.uv,
            s.occlusion, s.occlusionMap >= 0, derivatives, true));
    }
    surface.SetAlbedoAndSpecularF0(color, specular, metallic);
    surface.vertexNormal = VueOverlapSafeNormal16(vertexNormal, half3(surface.vertexNormal));
    surface.normal = VueOverlapSafeNormal16(normal, half3(surface.vertexNormal));
    surface.roughnessLinear = roughness; surface.CalculateRoughnessA();
    surface.diffuseAmbientOcclusion = occlusion;
    return true;
}

bool VueTryTerrainOverlap(VsOutput IN, VsSystemValues SV, PixelGeometryData geoData,
    const MaterialParameters params, float4 uvDxDy, out Surface surface)
{
    // SampleGrad footprints must be continuous across pair endpoint exits.
    float4 worldDerivatives = float4(ddx(geoData.positionWS.xy), ddy(geoData.positionWS.xy));
    // A constant-data bit lookup rejects whole world tiles before any
    // contributor height/material texture sampling. Uncertain tiles are exact.
    if ((o_terrainContributorControl == 2 || o_terrainContributorControl == 3) && VueContributorReady(params))
    {
        uint tile = VueContributorTile(geoData.positionWS.xy);
        if (o_terrainContributorControl == 2 && tile == 2) discard;
        if (o_terrainContributorControl == 3 && tile == 1) return false;
    }
    if (VueTryOverlapPages(IN, SV, geoData, params, uvDxDy, worldDerivatives, surface)) return true;
    if (o_terrainHeightFp16) return VueTryTerrainOverlap16(IN, SV, geoData, params, uvDxDy, worldDerivatives, surface);
    return VueTryTerrainOverlap32(IN, SV, geoData, params, uvDxDy, worldDerivatives, surface);
}
