static const uint VueContributorEndpoint[32] = { 4294950943u,4294901823u,4294836287u,4294443071u,4293918847u,4294443263u,4294902015u,4294935039u,4294935039u,4294959359u,4294963455u,4294965375u,4294965375u,4294966335u,4294966303u,4294966799u,4294966799u,4294966787u,4294967041u,4294967232u,4294967280u,4294967288u,4294967294u,4294967295u,4294967295u,4294967295u,4294967295u,4294967295u,4294967295u,4294967295u,4294967295u,4294967295u };
