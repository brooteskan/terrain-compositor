#pragma once

// Locally linear scalar footprint. This cannot recover detail already aliased
// upstream. Evaluate uniformly in a fragment shader before any hard threshold.
float TC_FilteredThreshold(float value, float threshold, float softness, float filterWidth)
{
    float delta = value - threshold;
    float pixelWidth = (abs(ddx(delta)) + abs(ddy(delta))) * max(filterWidth,0.0);
    float halfWidth = 0.5 * max(pixelWidth,max(softness,0.0));
    if (halfWidth <= 1e-7) return step(0.0,delta);
    return smoothstep(-halfWidth,halfWidth,delta);
}

float TC_FilteredRampPrimitive(float t)
{
    return t <= 0.0 ? 0.0 : (t < 1.0 ? 0.5*t*t : t-0.5);
}
float TC_FilteredRampFactor(float value, float start, float end, float filterWidth)
{
    float span = end-start;
    float delta = value-start;
    float deltaWidth = abs(ddx(delta))+abs(ddy(delta));
    float safeSpan = abs(span)>1e-7 ? span : 1.0;
    float t=delta/safeSpan;
    float width=(abs(ddx(t))+abs(ddy(t)))*max(filterWidth,0.0);
    if(abs(span)<=1e-7)
    {
        float halfWidth=0.5*deltaWidth*max(filterWidth,0.0);
        return halfWidth>1e-7 ? smoothstep(-halfWidth,halfWidth,delta) : step(0.0,delta);
    }
    // Exact one-dimensional box average of a clamped linear ramp. Early-outs
    // avoid cancellation for constant regions and vanishing footprints.
    float lo=t-0.5*width, hi=t+0.5*width;
    if(hi<=0.0) return 0.0;
    if(lo>=1.0) return 1.0;
    if(width<1e-4 || (lo>=0.0 && hi<=1.0)) return saturate(t);
    return saturate((TC_FilteredRampPrimitive(hi)-TC_FilteredRampPrimitive(lo))/width);
}
