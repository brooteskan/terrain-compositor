#pragma once

// Linear Rec.709/sRGB primaries. Alpha is carried through unchanged.
float TC_AdjustLuminance(float3 rgb)
{
    return dot(rgb, float3(0.2126, 0.7152, 0.0722));
}
float3 TC_Desaturate(float3 rgb, float amount)
{
    float luminance = TC_AdjustLuminance(rgb);
    return lerp(rgb, float3(luminance, luminance, luminance), saturate(amount));
}
float4 TC_Desaturate(float4 rgba, float amount)
{
    return float4(TC_Desaturate(rgba.rgb, amount), rgba.a);
}

float3 TC_TintByLuminance(float3 rgb, float3 tint, float amount)
{
    // Normalize the tint so the target retains the source luminance.
    // A black tint has no hue, so leave the source unchanged.
    tint = max(tint, float3(0.0, 0.0, 0.0));
    float tintLuminance = TC_AdjustLuminance(tint);
    if (tintLuminance <= 1e-6) return rgb;
    float3 target = tint * (TC_AdjustLuminance(rgb) / tintLuminance);
    return lerp(rgb, target, saturate(amount));
}
float4 TC_TintByLuminance(float4 rgba, float3 tint, float amount)
{
    return float4(TC_TintByLuminance(rgba.rgb, tint, amount), rgba.a);
}

float3 TC_HueShift(float3 rgb, float shift)
{
    // One shift unit is one full hue rotation; negative shifts are supported.
    // HSV is defined here for nonnegative RGB, including HDR values.
    float wrappedShift = frac(shift);
    if (wrappedShift == 0.0) return rgb;
    float3 positive = max(rgb, float3(0.0, 0.0, 0.0));
    float largest = max(positive.r, max(positive.g, positive.b));
    float smallest = min(positive.r, min(positive.g, positive.b));
    float chroma = largest - smallest;
    if (chroma <= 1e-7) return positive;
    float hue;
    if (largest == positive.r) hue = (positive.g-positive.b) / chroma;
    else if (largest == positive.g) hue = (positive.b-positive.r) / chroma + 2.0;
    else hue = (positive.r-positive.g) / chroma + 4.0;
    hue = frac(hue / 6.0 + wrappedShift);
    float3 wheel = saturate(abs(frac(hue + float3(0.0, 2.0/3.0, 1.0/3.0))*6.0-3.0)-1.0);
    return wheel * chroma + smallest;
}
float4 TC_HueShift(float4 rgba, float shift)
{
    return float4(TC_HueShift(rgba.rgb, shift), rgba.a);
}
