#pragma once
#include <TerrainCompositor/TerrainSurface.azsli>

// Surface-gradient bump mapping. Height is in meters; this changes only the
// shading normal. Derivatives include world scale and remain valid on slopes.
float3 TC_NormalFromHeight(float3 positionWS, float3 normalWS, float height, float strength)
{
    float3 normal = TC_SafeNormal(normalWS, float3(0, 0, 1));
    float3 dpdx = ddx(positionWS);
    float3 dpdy = ddy(positionWS);
    float3 r1 = cross(dpdy, normal);
    float3 r2 = cross(normal, dpdx);
    float determinant = dot(dpdx, r1);
    float dhdx = ddx(height);
    float dhdy = ddy(height);
    if (!isfinite(determinant) || abs(determinant) < 1e-12)
        return normal;
    float3 gradient = (dhdx * r1 + dhdy * r2) / determinant;
    return TC_SafeNormal(normal - strength * gradient, normal);
}
