    "ClassData": {
        "id": "{07A6CF16-AD78-44BE-A95E-2D6748E24B61}",
        "category": "Procedural",
        "title": "Voronoi Texture 2D",
        "titlePaletteName": "MathNodeTitlePalette",
        "description": "Blender-style 2D Voronoi with compact feature-specific searches and fractal controls. Single point evaluation per octave; no per-node supersampling. Fixed terrain-coordinate pattern; hash differs from Blender. Optional boundary antialiasing for F1/F2; fragment stage only.",
        "settings": {
            "includePaths": [
                "MaterialCanvas/Procedural/Voronoi.azsli"
            ],
            "instructions": [
                "TC_VoronoiResult NODEID_result = TC_Voronoi2D((float2)inVector, (float)inScale, (float)inDetail, (float)inRoughness, (float)inLacunarity, (float)inSmoothness, (float)inExponent, (float)inRandomness, inFeature, inMetric, (bool)inNormalize, (bool)inAntialias);"
            ]
        },
        "propertySlots": [
            {
                "name": "inFeature",
                "displayName": "Feature",
                "description": "F1: nearest site. F2: second nearest. SmoothF1: rounded blend. DistanceToEdge: nearest cell border. NSphereRadius: half the nearest-site separation.",
                "supportedDataTypeRegex": "string",
                "defaultDataType": "string",
                "defaultValue": {
                    "$type": "{03AAAB3F-5C47-5A66-9EBC-D5FA4DB353C9} AZStd::string",
                    "Value": "F1"
                },
                "enumValues": [
                    "F1",
                    "F2",
                    "SmoothF1",
                    "DistanceToEdge",
                    "NSphereRadius"
                ],
                "visibleOnNode": true,
                "editableOnNode": true,
                "settings": {
                    "instructions": [
                        "const uint SLOTNAME = TC_VoronoiFeature_SLOTVALUE;"
                    ]
                }
            },
            {
                "name": "inMetric",
                "displayName": "Distance Metric",
                "description": "Metric for F1, F2, and SmoothF1. Edge and radius modes always use Euclidean geometry.",
                "supportedDataTypeRegex": "string",
                "defaultDataType": "string",
                "defaultValue": {
                    "$type": "{03AAAB3F-5C47-5A66-9EBC-D5FA4DB353C9} AZStd::string",
                    "Value": "Euclidean"
                },
                "enumValues": [
                    "Euclidean",
                    "Manhattan",
                    "Chebychev",
                    "Minkowski"
                ],
                "visibleOnNode": true,
                "editableOnNode": true,
                "settings": {
                    "instructions": [
                        "const uint SLOTNAME = TC_VoronoiMetric_SLOTVALUE;"
                    ]
                }
            },
            {
                "name": "inNormalize",
                "displayName": "Normalize",
                "description": "Normalize distance and fractal color amplitude using Blender-style bounds. Ignored by N-Sphere Radius.",
                "supportedDataTypeRegex": "bool",
                "defaultDataType": "bool",
                "defaultValue": {
                    "$type": "bool",
                    "Value": false
                },
                "settings": {
                    "instructions": [
                        "SLOTTYPE SLOTNAME = SLOTVALUE;"
                    ]
                }
            },
            {
                "name": "inAntialias",
                "displayName": "Boundary Antialiasing",
                "description": "Optional local boundary blending for F1/F2 Distance and Color. Position remains a selected site. Other features are unchanged. Does not fully filter subpixel cells.",
                "supportedDataTypeRegex": "bool",
                "defaultDataType": "bool",
                "defaultValue": {
                    "$type": "bool",
                    "Value": false
                },
                "settings": {
                    "instructions": [
                        "SLOTTYPE SLOTNAME = SLOTVALUE;"
                    ]
                },
                "visibleOnNode": true,
                "editableOnNode": true
            }
        ],
        "inputSlots": [
            {
                "name": "inVector",
