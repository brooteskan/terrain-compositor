                }
            },
            {
                "name": "outPosition",
                "displayName": "Position",
                "description": "Feature position in input-coordinate units. Smooth and fractal modes blend it. Zero in edge/radius modes.",
                "supportedDataTypeRegex": "float2",
                "defaultDataType": "float2",
                "settings": {
                    "instructions": [
