                    ]
                }
            },
            {
                "name": "outRadius",
                "displayName": "Radius",
                "description": "Half the nearest feature-point separation. Available in N-Sphere Radius mode; zero otherwise.",
                "supportedDataTypeRegex": "float",
                "defaultDataType": "float",
                "settings": {
                    "instructions": [
                        "SLOTTYPE SLOTNAME = NODEID_result.radius;"
                    ]
                }
