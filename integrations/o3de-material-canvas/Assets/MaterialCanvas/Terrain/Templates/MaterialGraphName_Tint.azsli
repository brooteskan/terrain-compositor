TerrainSurfaceChannels TC_CanvasSurface(TerrainSurfaceContext context, const MaterialParameters params)
{
    const float3 O3DE_MC_POSITION_WS = context.worldPosition;
    const float3 O3DE_MC_NORMAL_WS = context.geometricNormal;
    // O3DE_GENERATED_INSTRUCTIONS_BEGIN: inBaseColor, inNormal, inRoughness, inMetalness, inSpecularFactor, inAmbientOcclusion
    float3 inBaseColor = float3(1, 1, 1);
    float3 inNormal = float3(0, 0, 0);
    float inRoughness = 1.0;
    float inMetalness = 0.0;
    float inSpecularFactor = 0.5;
    float inAmbientOcclusion = 1.0;
    // O3DE_GENERATED_INSTRUCTIONS_END
    TerrainSurfaceChannels result;
    result.baseColor = inBaseColor;
    result.normal = inNormal;
    result.roughness = inRoughness;
    result.metalness = inMetalness;
    result.specularFactor = inSpecularFactor;
    result.ambientOcclusion = inAmbientOcclusion;
    return result;
}
