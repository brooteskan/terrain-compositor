        "titlePaletteName": "MathNodeTitlePalette",
        "description": "Source-aware overlap material. Configure Material Overlap on the composition. Slots are 1 through 4.",
        "settings": {
            "includePaths": [
                "TerrainCompositor/TerrainOverlap.azsli",
                "Atom/Features/ColorManagement/TransformColor.azsli"
            ],
            "instructions": [
                "#ifndef TC_OVERLAP_LOCAL_SET",
                "#define TC_OVERLAP_LOCAL_SET",
                "TerrainOverlapSet O3DE_TC_OVERLAP = TC_ResolveOverlap(O3DE_MC_POSITION_WS);",
                "#endif",
                "uint NODEID_overlapSlot = TC_OverlapSlotIndex(materialSlot);",
                "TerrainOverlapSource NODEID_overlapSource = TC_OverlapMaterialSource(O3DE_TC_OVERLAP, NODEID_overlapSlot);",
                "float4 NODEID_overlapTexel = TC_SampleOverlapTexture(NODEID_overlapSource, O3DE_MC_POSITION_WS, scale, params.inValue, params.inSampler);",
                "SLOTTYPE(color) color = TransformColor(NODEID_overlapTexel.xyz, ColorSpaceId::LinearSRGB, ColorSpaceId::ACEScg);",
                "SLOTTYPE(raw) raw = NODEID_overlapTexel.xyz;",
                "SLOTTYPE(normal) normal = TC_OverlapNormal(NODEID_overlapSource, NODEID_overlapTexel.xyz, normalStrength, params.inValue >= 0);"
            ]
        },
        "inputSlots": [
