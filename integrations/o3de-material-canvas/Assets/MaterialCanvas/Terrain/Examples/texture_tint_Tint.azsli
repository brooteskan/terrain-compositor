float2 node4_terrain_tint_texture_uv = node3_world_xy_scale_value;
float3 node4_terrain_tint_texture_color = TerrainMaterialSrg::m_canvasTintTexture.Sample(TerrainMaterialSrg::m_canvasTintSampler, node4_terrain_tint_texture_uv).rgb;
