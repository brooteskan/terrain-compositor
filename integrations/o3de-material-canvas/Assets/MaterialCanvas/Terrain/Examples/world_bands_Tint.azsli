TerrainSurfaceChannels TC_CanvasSurface(TerrainSurfaceContext context, TerrainSurfaceChannels incoming)
{
    const float3 O3DE_MC_POSITION_WS = context.worldPosition;
    const float3 O3DE_MC_NORMAL_WS = context.geometricNormal;
    // O3DE_GENERATED_INSTRUCTIONS_BEGIN: inTint, inBaseColor, inNormal, inRoughness, inMetalness, inSpecularFactor, inAmbientOcclusion
float node1_terrain_tint_parameters_strength = saturate(TerrainMaterialSrg::m_canvasTintStrength);
float3 node1_terrain_tint_parameters_color = TerrainMaterialSrg::m_canvasTintColor;
float3 node2_world_position_outPosition = O3DE_MC_POSITION_WS;
float3 node4_world_bands_position = node2_world_position_outPosition;
float node4_world_bands_scale = 64;
float node4_world_bands_value = 0.5 + 0.5 * sin(node4_world_bands_position.x / max(node4_world_bands_scale, 0.0001));
float node5_multiply_inValue1 = node1_terrain_tint_parameters_strength;
float node5_multiply_inValue2 = node4_world_bands_value;
float node5_multiply_outValue = node5_multiply_inValue1 * node5_multiply_inValue2;
float3 node6_linear_interpolate_inValue1 = {1, 1, 1};
float3 node6_linear_interpolate_inValue2 = node1_terrain_tint_parameters_color;
float node6_linear_interpolate_inValue3 = node5_multiply_outValue;
float3 node6_linear_interpolate_outValue = lerp(node6_linear_interpolate_inValue1, node6_linear_interpolate_inValue2, node6_linear_interpolate_inValue3);
float3 inTint = node6_linear_interpolate_outValue;
float3 inBaseColor = incoming.baseColor;
float3 inNormal = incoming.normal;
float inRoughness = incoming.roughness;
float inMetalness = incoming.metalness;
float inSpecularFactor = incoming.specularFactor;
float inAmbientOcclusion = incoming.ambientOcclusion;
    // O3DE_GENERATED_INSTRUCTIONS_END
    TerrainSurfaceChannels result;
    result.baseColor = inBaseColor * inTint; // Retained ABI-v1 graph connection, neutral for new graphs.
    result.normal = inNormal;
    result.roughness = inRoughness;
    result.metalness = inMetalness;
    result.specularFactor = inSpecularFactor;
    result.ambientOcclusion = inAmbientOcclusion;
    return result;
}
