+    TerrainMeshManager::SectorPreparationRequest TerrainMeshManager::CaptureSectorRequest(
+        uint32_t lodLevel, size_t slot, std::shared_ptr<const SectorPreparationSettings> settings,
+        TerrainCompositor::TerrainMeshCutoutRenderChannelPtr channel, bool collectStatistics,
+        TerrainCompositor::TerrainMeshCutoutRenderSnapshotPtr snapshot,
+        std::shared_ptr<const SectorCommitGroup> group, const Vector2i* predictedCoordinate)
+    {
+        AZ_PROFILE_SCOPE(AzRender, "Terrain::CaptureSectorRequest");
+        SectorPreparationRequest request;
+        request.m_capturedAtUs = collectStatistics ? SectorTimestampUs() : 0.0;
+        auto& sector = m_sectorLods.at(lodLevel).m_sectors.at(slot);
+        const float gridMeters = (settings->m_gridSize * m_sampleSpacing) * (1 << lodLevel);
+        request.m_data.m_settings = AZStd::move(settings);
+        request.m_samplingPlan.m_channel = AZStd::move(channel);
+        request.m_samplingPlan.m_publication = AZStd::move(snapshot);
+        request.m_samplingPlan.m_dependencies.push_back({ m_preparationLifetime, m_preparationLifetime->Capture() });
+        {
+            AZ_PROFILE_SCOPE(AzRender, "Terrain::CaptureSectorSources");
+            request.m_samplingPlan.m_sources = TerrainCompositor::CaptureTerrainRenderQuerySources(request.m_samplingPlan.m_publication);
+        }
+        if (request.m_samplingPlan.m_sources)
+            request.m_samplingPlan.m_dependencies.insert(request.m_samplingPlan.m_dependencies.end(), request.m_samplingPlan.m_sources->m_dependencies.begin(),
+                request.m_samplingPlan.m_sources->m_dependencies.end());
+        if (auto cancellation = sector.m_pendingCancellation.lock()) cancellation->store(true, std::memory_order_release);
+        request.m_destinationIdentity = sector.m_destinationIdentity;
+        SetSectorState(sector, SectorState::Requested);
+        request.m_group = AZStd::move(group);
+        request.m_serial = ++sector.m_preparationSerial;
+        sector.m_pendingCancellation = request.m_cancelled;
+        SetSectorState(sector, SectorState::Preparing);
+        request.m_lodLevel = lodLevel;
+        request.m_slot = slot;
+        request.m_worldCoord = predictedCoordinate ? *predictedCoordinate : sector.m_requestedWorldCoord;
+        sector.m_pendingWorldCoord = request.m_worldCoord;
+        sector.m_pendingIsPrediction = predictedCoordinate && request.m_worldCoord != sector.m_requestedWorldCoord;
+        request.m_rayTracing = bool(sector.m_committed.m_rtData);
+        request.m_collectStatistics = collectStatistics;
+        request.m_data.m_samplesX = request.m_data.m_samplesY = request.m_data.m_settings->m_gridVerts1D;
+        request.m_data.m_worldStartPosition = request.m_worldCoord.ToVector2() * gridMeters;
+        request.m_data.m_vertexSpacing = gridMeters / request.m_data.m_settings->m_gridSize;
+        request.m_data.m_useVertexOrderRemap = true;
+        request.m_objectData.m_xyTranslation = { request.m_worldCoord.m_x * gridMeters, request.m_worldCoord.m_y * gridMeters };
+        request.m_objectData.m_xyScale = gridMeters * (aznumeric_cast<float>(AZStd::numeric_limits<uint8_t>::max()) /
+            request.m_data.m_settings->m_gridSize);
+        request.m_objectData.m_lodLevel = lodLevel;
+        request.m_objectData.m_rcpLodLevel = 1.0f / (lodLevel + 1);
+        const auto& heightBounds = request.m_data.m_settings->m_worldHeightBounds;
+        const AZ::Vector3 minimum(request.m_data.m_worldStartPosition.GetX(), request.m_data.m_worldStartPosition.GetY(), heightBounds.m_min);
+        const auto bounds = AZ::Aabb::CreateFromMinMax(minimum,
+            minimum + AZ::Vector3(gridMeters, gridMeters, heightBounds.m_max - heightBounds.m_min));
+        // This synchronous query is captured after the invalidation tickets so a
+        // source change during even an empty-area query invalidates its completion.
+        {
+            AZ_PROFILE_SCOPE(AzRender, "Terrain::CaptureSectorArea");
+            AzFramework::Terrain::TerrainDataRequestBus::BroadcastResult(
+                request.m_samplingPlan.m_area.m_exists, &AzFramework::Terrain::TerrainDataRequests::TerrainAreaExistsInBounds, bounds);
+        }
+        auto& sampling = request.m_samplingPlan;
+        sampling.m_area.m_bounds = bounds;
+        sampling.m_area.m_captured = true;
+        // The worker consumes only this owned boolean, never TerrainSystem or an
+        // area handler. Deferred acceptance re-queries it on the control thread
+        // before publication/dependency locks, including an authoritative false.
+        sampling.m_area.m_retainedAcrossFrames = true;
+        sampling.m_batchQueries = request.m_data.m_settings->m_batchQueries;
+        sampling.m_clodEnabled = request.m_data.m_settings->m_clodEnabled;
+        sampling.m_rayTracing = request.m_rayTracing;
+        sampling.m_regular = { request.m_data.m_worldStartPosition, request.m_data.m_vertexSpacing,
+            size_t(request.m_data.m_samplesX), size_t(request.m_data.m_samplesY), request.m_data.m_samplerType,
+            TerrainCompositor::TerrainSectorSampleChannels::HeightAndExistence, true };
+        sampling.m_clod = sampling.m_regular;
+        sampling.m_clod.m_samplesX = sampling.m_clod.m_samplesY = (request.m_data.m_settings->m_gridSize >> 1) + 1;
+        sampling.m_clod.m_spacing *= 2.0f;
+        sampling.m_clod.m_vertexOrderRemap = false;
+        return request;
+    }
+
+    TerrainMeshManager::PreparedSectorResult TerrainMeshManager::PrepareSector(SectorPreparationRequest request)
+    {
+        AZ_PROFILE_SCOPE(AzRender, "Terrain::PrepareSectorWorker");
+        PreparedSectorResult result;
+        result.m_request = AZStd::move(request);
+        auto& owned = result.m_request;
+        result.m_startedAtUs = owned.m_collectStatistics ? SectorTimestampUs() : 0.0;
+        const auto prepare = [&]()
+        {
+            TerrainCompositor::TerrainRenderQueryTimer timer(owned.m_collectStatistics ? &result.m_preparationMicroseconds : nullptr);
+            if (owned.m_cancelled->load(std::memory_order_acquire))
+            {
+                result.m_status = SectorPreparationStatus::Cancelled;
+                result.m_admission = TerrainCompositor::TerrainSectorAdmission::Cancelled;
+                return;
+            }
+            if (owned.m_collectStatistics)
+                result.m_queryStatistics = std::make_unique<TerrainCompositor::TerrainRenderQueryStatistics>();
+            TerrainCompositor::RecordTerrainRenderSourceAcquisitions(owned.m_samplingPlan.m_sources, result.m_queryStatistics.get());
+            auto& sampling = owned.m_samplingPlan;
+            sampling.Assess(result.m_queryStatistics.get());
+            result.m_admission = TerrainCompositor::AssessTerrainSectorAdmission(sampling,
+                owned.m_cancelled->load(std::memory_order_acquire));
+            if (result.m_admission != TerrainCompositor::TerrainSectorAdmission::Synchronous &&
+                result.m_admission != TerrainCompositor::TerrainSectorAdmission::Deferred)
+            {
+                if (result.m_admission == TerrainCompositor::TerrainSectorAdmission::Cancelled)
+                    result.m_status = SectorPreparationStatus::Cancelled;
+                return;
+            }
+            sampling.m_queryPolicy = owned.m_data.m_settings->m_retainedOnlyQueries && sampling.CanAvoidOrdinaryResults()
+                ? TerrainCompositor::TerrainSectorQueryPolicy::RetainedOnly
+                : TerrainCompositor::TerrainSectorQueryPolicy::OrdinaryThenOverlay;
+            if (!sampling.m_area.m_exists)
+            {
+                result.m_status = SectorPreparationStatus::Empty;
+                return;
+            }
+            const auto& settings = *owned.m_data.m_settings;
+            auto data = owned.m_data;
+            data.m_renderSnapshot = sampling.m_publication;
+            data.m_renderSources = sampling.m_sources;
+            data.m_retainedOnly = sampling.m_queryPolicy == TerrainCompositor::TerrainSectorQueryPolicy::RetainedOnly;
+            TerrainCompositor::TerrainSectorSampleReuse reuse(sampling);
+            if (data.m_retainedOnly && settings.m_sampleReuse && TerrainCompositor::TerrainSectorSampleReuse::Supported(sampling))
+                data.m_sampleReuse = &reuse;
+            // Only this synchronous kernel borrows its result's statistics storage.
+            data.m_queryStatistics = result.m_queryStatistics.get();
+            if (!GatherMeshData(data, result.m_heights, result.m_aabb, result.m_hasData, &sampling.m_regular)) return;
+            if (owned.m_cancelled->load(std::memory_order_acquire))
+            {
+                result.m_status = SectorPreparationStatus::Cancelled;
+                return;
+            }
+            if (sampling.m_clodEnabled && result.m_hasData)
+            {
+                AZ::Aabb unusedAabb = AZ::Aabb::CreateNull();
+                bool exists = false;
+                AZStd::vector<HeightNormalVertex> lodHeights;
+                if (!GatherMeshData(data, lodHeights, unusedAabb, exists, &sampling.m_clod)) return;
+                if (!exists)
+                {
+                    const HeightNormalVertex noTerrain{ NoTerrainVertexHeight, { 0, 0 } };
+                    AZStd::fill(lodHeights.begin(), lodHeights.end(), noTerrain);
+                }
+                PrepareSectorLodData(settings, result.m_heights, lodHeights, result.m_lodHeights);
+            }
+            if (owned.m_cancelled->load(std::memory_order_acquire))
+            {
+                result.m_status = SectorPreparationStatus::Cancelled;
+                return;
+            }
+            if (sampling.m_rayTracing && result.m_hasData)
+                PrepareSectorRayTracingData(settings, result.m_heights, result.m_rtPositions, result.m_rtNormals);
+            result.m_status = owned.m_cancelled->load(std::memory_order_acquire) ? SectorPreparationStatus::Cancelled :
+                result.m_hasData ? SectorPreparationStatus::Ready : SectorPreparationStatus::Empty;
+        };
+        prepare();
+        result.m_completedAtUs = owned.m_collectStatistics ? SectorTimestampUs() : 0.0;
+        return result;
+    }
+
+    AZ::Job* TerrainMeshManager::CreateSectorPreparationJob(std::shared_ptr<PreparedSectorResult> result, AZ::JobContext* context)
+    {
+        // JobFunction uses the pinned engine's 512-byte ThreadPoolAllocator.
+        // Keep the complete request in its existing result allocation so growing
+        // the plan cannot turn a pooled job allocation into a null pointer.
+        auto prepare = [result]() { *result = PrepareSector(AZStd::move(result->m_request)); };
+        using Job = AZ::JobFunction<decltype(prepare)>;
+        static_assert(sizeof(Job) <= 512, "Sector job exceeds the pinned engine job-pool allocation limit.");
+        return aznew Job(prepare, true, context);
+    }
+
+    double TerrainMeshManager::SectorTimestampUs()
+    {
+        return std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+
+    TerrainMeshManager::SectorRejection TerrainMeshManager::DeliverPreparedSector(PreparedSectorResult& result)
+    {
+        if (result.m_request.m_collectStatistics && !result.m_delivered) result.m_deliveredAtUs = SectorTimestampUs();
+        result.m_delivered = true;
+        auto* sector = FindPreparationDestination(result.m_request);
+        if (!sector) return SectorRejection::Destination;
+        const bool cancelled = !result.m_request.m_cancelled || result.m_request.m_cancelled->load(std::memory_order_acquire);
+        SetSectorState(*sector, cancelled || result.m_status == SectorPreparationStatus::Cancelled ? SectorState::Cancelled :
+            result.m_status == SectorPreparationStatus::Failed ? SectorState::Failed : SectorState::Ready);
+        return cancelled || result.m_status == SectorPreparationStatus::Cancelled ? SectorRejection::Cancelled :
+            result.m_status == SectorPreparationStatus::Failed ? SectorRejection::Failed : SectorRejection::None;
+    }
+
+    TerrainMeshManager::SectorRejection TerrainMeshManager::ValidateSectorReplacementUnit(
+        AZStd::span<const std::shared_ptr<PreparedSectorResult>> results)
+    {
+        if (results.empty()) return SectorRejection::IncompleteGroup;
+        for (const auto& result : results) if (!result) return SectorRejection::IncompleteGroup;
+        const auto& first = results.front()->m_request;
+        if (first.m_group && first.m_group->m_expectedResults != results.size()) return SectorRejection::IncompleteGroup;
+        for (size_t i = 0; i < results.size(); ++i)
+        {
+            const auto& request = results[i]->m_request;
+            if (request.m_group != first.m_group) return SectorRejection::IncompleteGroup;
+            if (request.m_stageUploads != first.m_stageUploads) return SectorRejection::Settings;
+            // Production groups share one immutable settings capture. Independent
+            // lifetime-test requests remain supported without manufacturing a group.
+            if (first.m_group && request.m_data.m_settings != first.m_data.m_settings) return SectorRejection::Settings;
+            for (size_t j = 0; j < i; ++j)
+                if (results[j]->m_request.m_destinationIdentity == request.m_destinationIdentity) return SectorRejection::Duplicate;
+        }
+        return SectorRejection::None;
+    }
+
+    AZ::u32 TerrainMeshManager::AssessSectorSplit(const SectorPreparationRequest& a, const SectorPreparationRequest& b,
+        const TerrainCompositor::TerrainSectorCoverageSelection& proposedCoverage)
+    {
+        using Blocker = TerrainCompositor::TerrainSectorSplitBlocker;
+        auto blockers = TerrainCompositor::AssessTerrainSectorSplitSampling(a.m_samplingPlan, b.m_samplingPlan);
+        if (!a.m_data.m_settings || a.m_data.m_settings != b.m_data.m_settings) blockers |= static_cast<AZ::u32>(Blocker::Settings);
+        if (!proposedCoverage.IsRepresentable()) blockers |= static_cast<AZ::u32>(Blocker::Coverage);
+        // Coverage projection proves only representability. Matching shared raw
+        // heights/existence/normal halos, CLOD samples and retained neighbor inputs
+        // still need a certificate. No smaller production replacement is enabled.
+        return blockers | static_cast<AZ::u32>(Blocker::WholeGroupPolicy);
+    }
+
+    size_t TerrainMeshManager::GetSectorUploadBytes(AZStd::span<const std::shared_ptr<PreparedSectorResult>> results)
+    {
+        size_t bytes = 0;
+        for (const auto& result : results)
+            if (result && result->m_hasData)
+            {
+                bytes += result->m_heights.size() * sizeof(HeightNormalVertex);
+                if (result->m_request.m_data.m_settings && result->m_request.m_data.m_settings->m_clodEnabled)
+                    bytes += result->m_lodHeights.size() * sizeof(HeightNormalVertex);
+                if (result->m_request.m_rayTracing)
+                    bytes += (result->m_rtPositions.size() + result->m_rtNormals.size()) * sizeof(RtVertex);
+            }
+        return bytes; // Payload bytes, not an estimate of upload duration/driver work.
+    }
+
+    TerrainMeshManager::SectorWorkStorage TerrainMeshManager::GetSectorWorkStorage(
+        AZStd::span<const std::shared_ptr<PreparedSectorResult>> results)
+    {
+        SectorWorkStorage storage;
+        // Caller owns these entries or has joined their jobs. Never poll mutable
+        // result vectors concurrently. Shared retained objects are counted once.
+        std::set<const void*> sources, publications, settings;
+        for (const auto& result : results)
+            if (result)
+            {
+                const auto& request = result->m_request;
+                if (result->m_delivered)
+                {
+                    ++storage.m_completedResults;
+                    storage.m_completedCpuBytes += GetPreparedCpuBytes(*result);
+                }
+                else
+                {
+                    ++storage.m_pendingResults;
+                    storage.m_pendingCpuBytes += GetPreparedCpuBytes(*result);
+                }
+                if (request.m_samplingPlan.m_sources && sources.insert(request.m_samplingPlan.m_sources.get()).second)
+                {
+                    const auto& retained = *request.m_samplingPlan.m_sources;
+                    storage.m_retainedSourceBytes += sizeof(retained) +
+                        retained.m_queries.capacity() * sizeof(TerrainCompositor::TerrainRenderGeometryQuery) +
+                        retained.m_dependencies.capacity() * sizeof(TerrainCompositor::TerrainPreparationDependencyTicket);
+                }
+                if (request.m_samplingPlan.m_publication && publications.insert(request.m_samplingPlan.m_publication.get()).second)
+                {
+                    const auto& retained = *request.m_samplingPlan.m_publication;
+                    storage.m_retainedPublicationBytes += sizeof(retained) +
+                        retained.m_cutouts.capacity() * sizeof(TerrainCompositor::PreparedTerrainMeshCutout) +
+                        retained.m_meshHeightGaps.capacity() * sizeof(TerrainCompositor::PreparedTerrainMeshHeightGap) +
+                        retained.m_compositionGenerations.capacity() * sizeof(AZStd::pair<AZ::Uuid, AZ::u64>) +
+                        retained.m_renderGeometryQueries.capacity() * sizeof(TerrainCompositor::TerrainRenderGeometryQuery);
+                }
+                if (request.m_data.m_settings && settings.insert(request.m_data.m_settings.get()).second)
+                    storage.m_sharedSettingsBytes += sizeof(SectorPreparationSettings) +
+                        request.m_data.m_settings->m_vertexOrder.capacity() * sizeof(uint16_t) +
+                        request.m_data.m_settings->m_xyPositions.capacity() * sizeof(XYPosition);
+            }
+        storage.m_retainedSourceSets = sources.size();
+        storage.m_retainedPublications = publications.size();
+        return storage;
+    }
+
+    void TerrainMeshManager::SetSectorState(Sector& sector, SectorState state, SectorRejection reason)
+    {
+        if (r_terrainSectorUpdateTiming)
+            AZ_Printf("TerrainSectorState",
+                "destination=%llu request=%llu requested=(%d,%d) committed=(%d,%d) lod=%u content=%llu publication=%llu "
+                "state=%u->%u reason=%u valid=%d group=%llu time-us=%.0f coverage-age-us=%.0f\n",
+                static_cast<unsigned long long>(sector.m_destinationIdentity->m_id),
+                static_cast<unsigned long long>(sector.m_preparationSerial),
+                sector.m_requestedWorldCoord.m_x, sector.m_requestedWorldCoord.m_y,
+                sector.m_committed.m_worldCoord.m_x, sector.m_committed.m_worldCoord.m_y, sector.m_committed.m_lodLevel,
+                static_cast<unsigned long long>(sector.m_committed.m_serial),
+                static_cast<unsigned long long>(sector.m_committed.m_publication ? sector.m_committed.m_publication->m_revision : 0),
+                static_cast<unsigned>(sector.m_state), static_cast<unsigned>(state), static_cast<unsigned>(reason), sector.m_committed.m_valid,
+                static_cast<unsigned long long>(sector.m_committed.m_groupId), SectorTimestampUs(),
+                sector.m_committed.m_valid && sector.m_committed.m_committedAtUs ? SectorTimestampUs() - sector.m_committed.m_committedAtUs : 0.0);
+        sector.m_state = state;
+    }
+
+    void TerrainMeshManager::RequestSectorPlacement(Sector& sector, Vector2i coordinate)
+    {
+        sector.m_deferredRetry = false;
+        if (auto cancellation = sector.m_pendingCancellation.lock(); cancellation &&
+            !cancellation->load(std::memory_order_acquire) && sector.m_pendingIsPrediction && sector.m_pendingWorldCoord == coordinate)
+        {
+            // Adopt the speculative lease without cancelling its owned work.
+            sector.m_pendingIsPrediction = false;
+            sector.m_requestedWorldCoord = coordinate;
+            m_candidateSectors.clear();
+            return;
+        }
+        if (auto cancellation = sector.m_pendingCancellation.lock()) cancellation->store(true, std::memory_order_release);
+        ++sector.m_preparationSerial;
+        sector.m_requestedWorldCoord = coordinate;
+        sector.m_pendingCancellation.reset();
+        SetSectorState(sector, SectorState::Requested);
+        m_candidateSectors.clear();
+    }
+
+    void TerrainMeshManager::CancelSectorPreparation(Sector& sector)
+    {
+        if (auto cancellation = sector.m_pendingCancellation.lock()) cancellation->store(true, std::memory_order_release);
+        ++sector.m_preparationSerial;
+        sector.m_pendingCancellation.reset();
+        SetSectorState(sector, SectorState::Cancelled, SectorRejection::Cancelled);
+        m_rebuildSectors = true;
+    }
+
+    TerrainMeshManager::Sector* TerrainMeshManager::FindPreparationDestination(const SectorPreparationRequest& request)
+    {
+        if (request.m_lodLevel >= m_sectorLods.size() || request.m_slot >= m_sectorLods[request.m_lodLevel].m_sectors.size()) return nullptr;
+        auto& sector = m_sectorLods[request.m_lodLevel].m_sectors[request.m_slot];
+        return sector.m_destinationIdentity == request.m_destinationIdentity && sector.m_preparationSerial == request.m_serial &&
+            sector.m_requestedWorldCoord == request.m_worldCoord ? &sector : nullptr;
+    }
+
+    size_t TerrainMeshManager::GetPreparedCpuBytes(const PreparedSectorResult& result)
+    {
+        // Owned storage only. Publications/settings/source snapshots are shared;
+        // their transitive allocations and driver/BLAS allocations are not estimated.
+        return sizeof(result) + result.m_heights.capacity() * sizeof(HeightNormalVertex) +
+            result.m_lodHeights.capacity() * sizeof(HeightNormalVertex) +
+            (result.m_rtPositions.capacity() + result.m_rtNormals.capacity()) * sizeof(RtVertex) +
+            result.m_request.m_samplingPlan.m_dependencies.capacity() * sizeof(TerrainCompositor::TerrainPreparationDependencyTicket);
+    }
+
+    TerrainMeshManager::SectorResourceAccounting TerrainMeshManager::GetSectorResourceAccounting() const
+    {
+        SectorResourceAccounting accounting;
+        std::set<const TerrainCompositor::TerrainPreparationDependencySet*> countedDependencies;
+        for (const auto& lod : m_sectorLods)
+            for (const auto& sector : lod.m_sectors)
+            {
+                const auto& committed = sector.m_committed;
+                const auto bytes = [](const auto& buffer) -> size_t { return buffer ? buffer->GetBufferSize() : 0; };
+                size_t gpu = bytes(committed.m_heightsNormalsBuffer) + bytes(committed.m_lodHeightsNormalsBuffer);
+                if (committed.m_rtData) gpu += bytes(committed.m_rtData->m_positionsBuffer) + bytes(committed.m_rtData->m_normalsBuffer);
+                accounting.m_allocatedGpuBytes += gpu;
+                if (committed.m_valid && sector.m_state != SectorState::Committed) accounting.m_retainedGpuBytes += gpu;
+                accounting.m_committedCpuBytes += sizeof(committed);
+                if (committed.m_dependencies && countedDependencies.insert(committed.m_dependencies.get()).second)
+                    accounting.m_committedCpuBytes += sizeof(*committed.m_dependencies) + committed.m_dependencies->GetHeapBytes();
+                if (sector.m_state == SectorState::Preparing || sector.m_state == SectorState::Ready) ++accounting.m_pendingRequests;
+            }
+        return accounting;
+    }
+
+    void TerrainMeshManager::RemoveSectorRayTracedMeshes(Sector& sector)
+    {
+        if (sector.m_committed.m_rtData)
+            for (auto& group : sector.m_committed.m_rtData->m_meshGroups)
+                if (group.m_isVisible)
+                {
+                    m_rayTracingFeatureProcessor->RemoveMesh(group.m_id);
+                    group.m_isVisible = false;
+                }
+        AZStd::erase_if(m_rayTracedItems, [&sector](const RayTracedItem& item) { return item.m_sector == &sector; });
+    }
+
+    void TerrainMeshManager::HideCommittedSector(Sector& sector)
+    {
+        RemoveSectorRayTracedMeshes(sector);
+        auto& committed = sector.m_committed;
+        committed.m_valid = false;
+        committed.m_channel.reset();
+        committed.m_publication.reset();
+        committed.m_dependencies.reset();
+        m_candidateSectors.clear();
+    }
+
+    void TerrainMeshManager::RefreshCommittedCoverage()
+    {
+        AZ_PROFILE_SCOPE(AzRender, "Terrain::RefreshCommittedCoverage");
+        // Control-thread visibility admission. Use the same publication -> sorted
+        // dependency lock order as commit; never call source/terrain callbacks here.
+        for (auto& lod : m_sectorLods)
+            for (auto& sector : lod.m_sectors)
+            {
+                auto& committed = sector.m_committed;
+                if (!committed.m_valid) continue;
+                bool valid = true;
+                {
+                    std::unique_lock<std::mutex> publicationLock;
+                    if (committed.m_channel)
+                    {
+                        publicationLock = std::unique_lock<std::mutex>(committed.m_channel->m_publicationMutex);
+                        valid = committed.m_channel->m_active && committed.m_channel->m_snapshot.load(std::memory_order_acquire) == committed.m_publication;
+                    }
+                    if (r_terrainReuseControlStorage)
+                    {
+                        TerrainCompositor::TerrainPreparationAdmission admission(committed.m_dependencies, m_coverageAdmissionScratch);
+                        valid = valid && admission.IsValid();
+                    }
+                    else if (committed.m_dependencies)
+                    {
+                        TerrainCompositor::TerrainPreparationAdmission admission(committed.m_dependencies->GetTickets());
+                        valid = valid && admission.IsValid();
+                    }
+                    else valid = false;
+                }
+                if (!valid)
+                {
+                    HideCommittedSector(sector);
+                    SetSectorState(sector, SectorState::Invalidated);
+                    m_rebuildSectors = true;
+                }
+            }
+    }
+
+    bool TerrainMeshManager::ValidateRecoverySampling(AZStd::span<const std::shared_ptr<PreparedSectorResult>> results) const
+    {
+        for (size_t i = 0; i < results.size(); ++i)
+        {
+            const auto& request = results[i]->m_request;
+            const auto certificate = TerrainCompositor::CertifyTerrainSectorSampling(request.m_samplingPlan);
+            if (!certificate.m_proven) return false;
+            const auto compatible = [&](const auto& otherCertificate, const auto& publication, const auto& dependencies)
+            {
+                return !TerrainCompositor::TerrainSectorCertificatesOverlap(certificate, otherCertificate) ||
+                    (otherCertificate.m_proven && otherCertificate.m_regular.m_sampler == certificate.m_regular.m_sampler &&
+                        otherCertificate.m_clodEnabled == certificate.m_clodEnabled &&
+                        publication == request.m_samplingPlan.m_publication && dependencies &&
+                        dependencies->Matches(request.m_samplingPlan.m_dependencies));
+            };
+            for (size_t j = 0; j < i; ++j)
+            {
+                const auto& other = results[j]->m_request.m_samplingPlan;
+                const auto dependencies = std::make_shared<const TerrainCompositor::TerrainPreparationDependencySet>(other.m_dependencies);
+                if (!compatible(TerrainCompositor::CertifyTerrainSectorSampling(other), other.m_publication, dependencies)) return false;
+            }
+            for (const auto& lod : m_sectorLods)
+                for (const auto& sector : lod.m_sectors)
+                {
+                    if (!sector.m_committed.m_valid || AZStd::any_of(results.begin(), results.end(),
+                        [&](const auto& result) { return result->m_request.m_destinationIdentity == sector.m_destinationIdentity; })) continue;
+                    const auto& other = sector.m_committed;
+                    if (!compatible(other.m_samplingCertificate, other.m_publication, other.m_dependencies)) return false;
+                }
+        }
+        return true;
+    }
+
+    bool TerrainMeshManager::AcceptPreparedSectors(
+        AZStd::span<const std::shared_ptr<PreparedSectorResult>> results,
+        const AZStd::function<void(Sector&, const PreparedSectorResult&)>& commit,
+        SectorCommitStatistics* statistics, size_t remainingUploadBytes, size_t maximumUploadBytes)
+    {
+        AZ_PROFILE_SCOPE(AzRender, "Terrain::AcceptPreparedSectors");
+        TerrainCompositor::TerrainRenderQueryTimer acceptanceTimer(statistics ? &statistics->m_acceptanceMicroseconds : nullptr);
+        if (statistics) *statistics = {};
+        if (results.empty()) return true;
+        // Upload completion is a separate gate from data readiness. An early
+        // attempt keeps the complete group and every destination lease intact.
+        for (const auto& result : results)
+            if (result && result->m_request.m_stageUploads && result->m_status == SectorPreparationStatus::Ready &&
+                (!result->m_uploads || !result->m_uploads->m_ready || !SectorUploadsComplete(*result)))
+            {
+                if (statistics) statistics->m_rejection = SectorRejection::UploadPending;
+                return false;
+            }
+        const auto reject = [&](SectorRejection reason)
+        {
+            if (statistics) statistics->m_rejection = reason;
+            // Stale completions never change the state of a replacement request.
+            for (const auto& result : results)
+                if (result)
+                {
+                    if (auto* sector = FindPreparationDestination(result->m_request)) SetSectorState(*sector, sector->m_state, reason);
+                    if (r_terrainSectorUpdateTiming)
+                        AZ_Printf("TerrainSectorReject", "destination=%llu request=%llu requested=(%d,%d) lod=%u reason=%u cpu-bytes=%zu group=%llu time-us=%.0f\n",
+                            static_cast<unsigned long long>(result->m_request.m_destinationIdentity ? result->m_request.m_destinationIdentity->m_id : 0),
+                            static_cast<unsigned long long>(result->m_request.m_serial), result->m_request.m_worldCoord.m_x,
+                            result->m_request.m_worldCoord.m_y, result->m_request.m_lodLevel, static_cast<unsigned>(reason), GetPreparedCpuBytes(*result),
+                            static_cast<unsigned long long>(result->m_request.m_group ? result->m_request.m_group->m_id : 0), SectorTimestampUs());
+                }
+            m_rebuildSectors = true;
+            return false;
+        };
+        // Worker completion and replacement admission are separate decisions.
+        for (const auto& result : results)
+            if (result)
+            {
+                DeliverPreparedSector(*result);
+                if (statistics) statistics->m_pendingCpuBytes += GetPreparedCpuBytes(*result);
+            }
+        const auto unit = ValidateSectorReplacementUnit(results);
+        if (unit != SectorRejection::None) return reject(unit);
+        const auto& first = results.front()->m_request;
+        for (const auto& result : results)
+            if (result->m_request.m_samplingPlan.m_schedulePolicy == TerrainCompositor::TerrainSectorSchedulePolicy::Deferred)
+            {
+                const auto& request = result->m_request;
+                const auto& settings = *request.m_data.m_settings;
+                if (settings.m_gridSize != m_gridSize || settings.m_gridVerts1D != m_gridVerts1D ||
+                    settings.m_gridVerts2D != m_gridVerts2D || settings.m_worldHeightBounds.m_min != m_worldHeightBounds.m_min ||
+                    settings.m_worldHeightBounds.m_max != m_worldHeightBounds.m_max || settings.m_clodEnabled != m_config.m_clodEnabled ||
+                    settings.m_batchQueries != bool(r_terrainBatchRenderQueries) ||
+                    settings.m_sampleReuse != bool(r_terrainSampleReuse) || !r_terrainRetainedOnlyQueries)
+                    return reject(SectorRejection::Settings);
+                bool exists = false;
+                AzFramework::Terrain::TerrainDataRequestBus::BroadcastResult(exists,
+                    &AzFramework::Terrain::TerrainDataRequests::TerrainAreaExistsInBounds, request.m_samplingPlan.m_area.m_bounds);
+                if (exists != request.m_samplingPlan.m_area.m_exists) return reject(SectorRejection::Dependency);
+            }
+        std::vector<std::shared_ptr<const TerrainCompositor::TerrainPreparationDependencySet>> committedDependencies;
+        committedDependencies.reserve(results.size());
+        for (const auto& result : results)
+        {
+            const auto& tickets = result->m_request.m_samplingPlan.m_dependencies;
+            const auto matching = std::find_if(committedDependencies.begin(), committedDependencies.end(),
+                [&](const auto& set) { return set->Matches(tickets); });
+            committedDependencies.push_back(matching != committedDependencies.end() ? *matching :
+                std::make_shared<const TerrainCompositor::TerrainPreparationDependencySet>(tickets));
+        }
+        std::unique_lock<std::mutex> publicationLock;
+        if (first.m_samplingPlan.m_channel)
+        {
+            AZ_PROFILE_SCOPE(AzRender, "Terrain::WaitForSectorPublication");
+            TerrainCompositor::TerrainRenderQueryTimer waitTimer(statistics ? &statistics->m_publicationWaitMicroseconds : nullptr);
+            publicationLock = std::unique_lock<std::mutex>(first.m_samplingPlan.m_channel->m_publicationMutex);
+            if (!first.m_samplingPlan.m_channel->m_active || first.m_samplingPlan.m_channel->m_snapshot.load(std::memory_order_acquire) != first.m_samplingPlan.m_publication)
+                return reject(SectorRejection::Publication);
+        }
+        AZStd::vector<TerrainCompositor::TerrainPreparationDependencyTicket> dependencies;
+        for (const auto& result : results)
+            dependencies.insert(dependencies.end(), result->m_request.m_samplingPlan.m_dependencies.begin(), result->m_request.m_samplingPlan.m_dependencies.end());
+        TerrainCompositor::TerrainPreparationAdmission admission(dependencies);
+        if (!admission.IsValid()) return reject(SectorRejection::Dependency);
+        // Validate the entire synchronous group before any lease consumption or
+        // GPU/SRG/AABB/RT/visibility mutation. Hold both locks through every commit.
+        for (size_t index = 0; index < results.size(); ++index)
+        {
+            const auto& result = *results[index];
+            const auto& request = result.m_request;
+            if (result.m_status == SectorPreparationStatus::Failed) return reject(SectorRejection::Failed);
+            if (result.m_status == SectorPreparationStatus::Cancelled || !request.m_cancelled || request.m_cancelled->load(std::memory_order_acquire))
+                return reject(SectorRejection::Cancelled);
+            if (request.m_group != first.m_group) return reject(SectorRejection::IncompleteGroup);
+            if (request.m_samplingPlan.m_channel != first.m_samplingPlan.m_channel || request.m_samplingPlan.m_publication != first.m_samplingPlan.m_publication)
+                return reject(SectorRejection::Publication);
+            if (request.m_samplingPlan.m_dependencies.empty() || request.m_samplingPlan.m_dependencies.front().m_dependency != m_preparationLifetime)
+                return reject(SectorRejection::Dependency);
+            const auto* sector = FindPreparationDestination(request);
+            if (!sector || bool(sector->m_committed.m_rtData) != request.m_rayTracing) return reject(SectorRejection::Destination);
+            for (size_t previous = 0; previous < index; ++previous)
+                if (results[previous]->m_request.m_destinationIdentity == request.m_destinationIdentity) return reject(SectorRejection::Duplicate);
+            if (!request.m_data.m_settings) return reject(SectorRejection::Payload);
+            const auto& settings = *request.m_data.m_settings;
+            if (result.m_status == SectorPreparationStatus::Ready)
+            {
+                if (!result.m_hasData || !result.m_aabb.IsValid() || result.m_heights.size() != settings.m_gridVerts2D ||
+                    (settings.m_clodEnabled && result.m_lodHeights.size() != settings.m_gridVerts2D) ||
+                    (request.m_rayTracing && (result.m_rtPositions.size() != settings.m_gridVerts2D || result.m_rtNormals.size() != settings.m_gridVerts2D)))
+                    return reject(SectorRejection::Payload);
+            }
+            else if (result.m_status != SectorPreparationStatus::Empty || result.m_hasData) return reject(SectorRejection::Payload);
+        }
+        const auto budget = TerrainCompositor::AssessTerrainSectorCommitBudget(
+            GetSectorUploadBytes(results), remainingUploadBytes, maximumUploadBytes);
+        if (budget != TerrainCompositor::TerrainSectorCommitAdmission::CommitWhole)
+        {
+            // Retain ready work for a later budget decision. Budget deferral is
+            // not source invalidation and must not request a full resample.
+            if (statistics) statistics->m_rejection = budget == TerrainCompositor::TerrainSectorCommitAdmission::WaitForBudget ?
+                SectorRejection::Budget : SectorRejection::AtomicGroupTooLarge;
+            return false;
+        }
+        if (first.m_group && first.m_group->m_boundedRecovery)
+        {
+            if (!ValidateRecoverySampling(results)) return reject(SectorRejection::Sampling);
+            AZStd::vector<TerrainCompositor::TerrainSectorCoverageClaim> claims;
+            for (const auto& lod : m_sectorLods)
+                for (const auto& sector : lod.m_sectors)
+                {
+                    const auto& committed = sector.m_committed;
+                    if (committed.m_valid && TerrainCompositor::IsWithinTerrainCoverage(committed.m_hasData, committed.m_aabb,
+                        m_cameraPosition, std::ldexp(m_config.m_firstLodDistance * m_config.m_firstLodDistance, 2 * committed.m_lodLevel)) &&
+                        AZStd::none_of(results.begin(), results.end(),
+                        [&](const auto& result) { return result->m_request.m_destinationIdentity == sector.m_destinationIdentity; }))
+                        claims.push_back({ committed.m_worldCoord.m_x, committed.m_worldCoord.m_y, committed.m_lodLevel, committed.m_hasData });
+                }
+            for (const auto& result : results)
+                if (TerrainCompositor::IsWithinTerrainCoverage(result->m_hasData, result->m_aabb,
+                    m_cameraPosition, std::ldexp(m_config.m_firstLodDistance * m_config.m_firstLodDistance, 2 * result->m_request.m_lodLevel)))
+                claims.push_back({ result->m_request.m_worldCoord.m_x, result->m_request.m_worldCoord.m_y,
+                    result->m_request.m_lodLevel, result->m_hasData });
+            if (!TerrainCompositor::SelectTerrainSectorCoverage(claims, m_sectorLods.size()).IsRepresentable())
+                return reject(SectorRejection::Coverage);
+        }
+        AZ_PROFILE_SCOPE(AzRender, "Terrain::CommitSectorUploads");
+        TerrainCompositor::TerrainRenderQueryTimer commitTimer(statistics ? &statistics->m_commitMicroseconds : nullptr);
+        // Acceptance consumes all leases; cancellation after this point is too late.
+        for (const auto& result : results)
+            ++m_sectorLods[result->m_request.m_lodLevel].m_sectors[result->m_request.m_slot].m_preparationSerial;
+        for (const auto& result : results)
+        {
+            auto& sector = m_sectorLods[result->m_request.m_lodLevel].m_sectors[result->m_request.m_slot];
+            sector.m_committed.m_valid = false;
+            RemoveSectorRayTracedMeshes(sector);
+        }
+        size_t committedIndex = 0;
+        for (const auto& result : results)
+        {
+            auto& sector = m_sectorLods[result->m_request.m_lodLevel].m_sectors[result->m_request.m_slot];
+            auto& committed = sector.m_committed;
+            const auto& request = result->m_request;
+            committed.m_worldCoord = request.m_worldCoord;
+            committed.m_lodLevel = request.m_lodLevel;
+            committed.m_serial = request.m_serial;
+            committed.m_groupId = request.m_group ? request.m_group->m_id : 0;
+            committed.m_committedAtUs = request.m_collectStatistics ? SectorTimestampUs() : 0.0;
+            committed.m_objectData = request.m_objectData;
+            committed.m_heightOrigin = request.m_data.m_settings->m_worldHeightBounds.m_min;
+            committed.m_channel = request.m_samplingPlan.m_channel;
+            committed.m_publication = request.m_samplingPlan.m_publication;
+            committed.m_dependencies = committedDependencies[committedIndex++];
+            committed.m_samplingCertificate = TerrainCompositor::CertifyTerrainSectorSampling(request.m_samplingPlan);
+            committed.m_hasData = result->m_hasData;
+            committed.m_aabb = result->m_hasData ? result->m_aabb : AZ::Aabb::CreateNull();
+            CreateAabbQuadrants(committed.m_aabb, committed.m_quadrantAabbs);
+            commit(sector, *result);
+        }
+        // Publish visibility only after every resource bundle has been replaced.
+        for (const auto& result : results)
+        {
+            auto& sector = m_sectorLods[result->m_request.m_lodLevel].m_sectors[result->m_request.m_slot];
+            sector.m_committed.m_valid = true;
+            sector.m_pendingCancellation.reset();
+            SetSectorState(sector, SectorState::Committed);
+        }
+        m_candidateSectors.clear();
+        return true;
+    }
+
+    AZStd::vector<TerrainMeshManager::SectorCoverage> TerrainMeshManager::SelectSectorCoverage()
+    {
+        AZ_PROFILE_SCOPE(AzRender, "Terrain::SelectSectorCoverage");
+        RefreshCommittedCoverage();
+        AZStd::vector<TerrainCompositor::TerrainSectorCoverageClaim> claims;
+        AZStd::vector<Sector*> sectors;
+        float distanceSq = m_config.m_firstLodDistance * m_config.m_firstLodDistance;
+        for (auto& lod : m_sectorLods)
+        {
+            for (auto& sector : lod.m_sectors)
+            {
+                const auto& committed = sector.m_committed;
+                if (!committed.m_valid || !TerrainCompositor::IsWithinTerrainCoverage(committed.m_hasData, committed.m_aabb, m_cameraPosition, distanceSq)) continue;
+                claims.push_back({ committed.m_worldCoord.m_x, committed.m_worldCoord.m_y, committed.m_lodLevel, committed.m_hasData });
+                sectors.push_back(&sector);
+            }
+            distanceSq *= 4.0f;
+        }
+        const auto projection = TerrainCompositor::SelectTerrainSectorCoverage(claims, m_sectorLods.size());
+        AZStd::vector<SectorCoverage> selected;
+        for (const auto& draw : projection.m_draws) selected.push_back({ sectors[draw.m_claim], draw.m_quadrants });
+        return selected;
+    }
+
+    void TerrainMeshManager::CommitSectorResources(Sector& sector, const PreparedSectorResult& result)
+    {
+        if (result.m_hasData)
+        {
+            if (result.m_request.m_stageUploads)
+            {
+                auto& uploads = *result.m_uploads;
+                auto& committed = sector.m_committed;
+                AZStd::swap(committed.m_heightsNormalsBuffer, uploads.m_buffers[0]);
+                if (result.m_request.m_data.m_settings->m_clodEnabled)
+                    AZStd::swap(committed.m_lodHeightsNormalsBuffer, uploads.m_buffers[1]);
+                AZStd::swap(committed.m_rtData, uploads.m_rtData);
+                // Draw packets reference these stable geometry-view objects.
+                // Only their streams change; no draw packet/SRG allocation is
+                // needed inside atomic publication. Old buffers/RT metadata are
+                // released with the completed group after the commit locks exit.
+                SetSectorBufferViews(committed);
+            }
+            else
+            {
+                UpdateSectorBuffers(sector, result.m_heights, result.m_rtPositions, result.m_rtNormals);
+                if (result.m_request.m_data.m_settings->m_clodEnabled)
+                    sector.m_committed.m_lodHeightsNormalsBuffer->UpdateData(
+                        result.m_lodHeights.data(), result.m_lodHeights.size() * sizeof(HeightNormalVertex), 0);
+            }
+        }
+        sector.m_committed.m_srg->SetConstant(m_patchDataIndex, result.m_request.m_objectData);
+        if (!sector.m_committed.m_isQueuedForSrgCompile)
+        {
+            sector.m_committed.m_isQueuedForSrgCompile = true;
+            m_sectorsThatNeedSrgCompiled.push_back(&sector);
+        }
+        m_candidateSectors.clear();
+    }
+
+    void TerrainMeshManager::SetSectorBufferViews(CommittedSector& sector)
+    {
+        AZStd::array<AZ::RHI::StreamBufferView, StreamIndex::Count> views;
+        views[StreamIndex::XYPositions] = CreateStreamBufferView(m_xyPositionsBuffer);
+        views[StreamIndex::Heights] = CreateStreamBufferView(sector.m_heightsNormalsBuffer);
+        views[StreamIndex::Normals] = CreateStreamBufferView(sector.m_heightsNormalsBuffer, AZ::RHI::GetFormatSize(HeightFormat));
+        auto& clod = m_config.m_clodEnabled ? sector.m_lodHeightsNormalsBuffer : m_dummyLodHeightsNormalsBuffer;
+        views[StreamIndex::LodHeights] = CreateStreamBufferView(clod);
+        views[StreamIndex::LodNormals] = CreateStreamBufferView(clod, AZ::RHI::GetFormatSize(HeightFormat));
+        // Keep XY and any shader-added dummy stream unchanged. Updating slots
+        // in place also preserves the device geometry objects used by packets.
+        for (uint8_t stream = StreamIndex::Heights; stream < StreamIndex::Count; ++stream)
+        {
+            sector.m_geometryView.SetStreamBufferView(stream, views[stream]);
+            for (auto& quadrant : sector.m_quadrantGeometryViews) quadrant.SetStreamBufferView(stream, views[stream]);
+        }
+    }
+
+    bool TerrainMeshManager::StageSectorResources(PreparedSectorResult& result, size_t step)
+    {
+        if (result.m_status == SectorPreparationStatus::Empty) return true;
+        if (result.m_status != SectorPreparationStatus::Ready || !result.m_hasData || step >= 5) return false;
+        if (!result.m_uploads) result.m_uploads = std::make_unique<PreparedSectorResult::Uploads>();
+        auto& uploads = *result.m_uploads;
+        const auto& request = result.m_request;
+        if (step == 4)
+        {
+            if (request.m_rayTracing)
+            {
+                uploads.m_rtData = AZStd::make_unique<RtSector>();
+                uploads.m_rtData->m_positionsBuffer = uploads.m_buffers[2];
+                uploads.m_rtData->m_normalsBuffer = uploads.m_buffers[3];
+                BuildRtSectorViews(*uploads.m_rtData, request.m_lodLevel);
+            }
+            return true;
+        }
+        if ((step == 1 && !request.m_data.m_settings->m_clodEnabled) || (step >= 2 && !request.m_rayTracing)) return true;
+        const bool rt = step >= 2;
+        const void* source = step == 0 ? static_cast<const void*>(result.m_heights.data()) :
+            step == 1 ? static_cast<const void*>(result.m_lodHeights.data()) :
+            step == 2 ? static_cast<const void*>(result.m_rtPositions.data()) : static_cast<const void*>(result.m_rtNormals.data());
+        const size_t count = step == 0 ? result.m_heights.size() : step == 1 ? result.m_lodHeights.size() :
+            step == 2 ? result.m_rtPositions.size() : result.m_rtNormals.size();
+        if (count != request.m_data.m_settings->m_gridVerts2D) return false;
+        auto& buffer = uploads.m_buffers[step];
+        buffer = rt ? CreateRayTracingMeshBufferInstance(AZ::RHI::Format::R32G32B32_FLOAT, aznumeric_cast<uint32_t>(count)) :
+            CreateMeshBufferInstance(sizeof(HeightNormalVertex), aznumeric_cast<uint32_t>(count));
+        if (!buffer || !buffer->GetRHIBuffer()->IsInitialized()) return false;
+        auto* rhiBuffer = buffer->GetRHIBuffer();
+        auto& fence = uploads.m_transferFences[step];
+        fence = aznew AZ::RHI::Fence;
+        if (fence->Init(rhiBuffer->GetDeviceMask(), AZ::RHI::FenceState::Reset) != AZ::RHI::ResultCode::Success) return false;
+        auto pool = AZ::RPI::BufferSystemInterface::Get()->GetCommonBufferPool(rt ?
+            AZ::RPI::CommonBufferPoolType::DynamicInputAssembly : AZ::RPI::CommonBufferPoolType::StaticInputAssembly);
+        if (!pool) return false;
+        // Submit per device so a failure on a later device still leaves an exact
+        // list of earlier transfers whose source data must remain alive.
+        for (int device = 0; device < AZ::RHI::RHISystemInterface::Get()->GetDeviceCount(); ++device)
+            if (rhiBuffer->IsDeviceSet(device))
+            {
+                auto deviceFence = fence->GetDeviceFence(device);
+                AZ::RHI::DeviceBufferStreamRequest transfer;
+                transfer.m_buffer = rhiBuffer->GetDeviceBuffer(device).get();
+                transfer.m_fenceToSignal = deviceFence.get();
+                transfer.m_sourceData = source;
+                transfer.m_byteCount = count * (rt ? sizeof(RtVertex) : sizeof(HeightNormalVertex));
+                if (pool->GetDeviceBufferPool(device)->StreamBuffer(transfer) != AZ::RHI::ResultCode::Success) return false;
+                uploads.m_fences.push_back(AZStd::move(deviceFence));
+            }
+        return true;
+    }
+
+    bool TerrainMeshManager::SectorUploadsComplete(const PreparedSectorResult& result, bool wait)
+    {
+        if (result.m_uploads)
+            for (const auto& fence : result.m_uploads->m_fences)
+            {
+                if (wait) fence->WaitOnCpu();
+                if (fence->GetFenceState() != AZ::RHI::FenceState::Signaled) return false;
+            }
+        return true;
+    }
+
+    void TerrainMeshManager::ReleaseSectorUploads(PreparedSectorResult& result)
+    {
+        if (result.m_uploads && result.m_uploads->m_rtData && m_meshfeatureProcessor)
+            for (auto& group : result.m_uploads->m_rtData->m_meshGroups)
+                for (auto& submesh : group.m_submeshVector)
+                    m_meshfeatureProcessor->ReleaseMeshInfoEntry(submesh.m_meshInfoHandle);
+        result.m_uploads.reset();
+    }
+
+    void TerrainMeshManager::DrainDeferredGroups()
+    {
+        if (m_sectorDispatcher) m_sectorDispatcher->Drain();
+        for (auto& group : m_deferredGroups)
+            for (const auto& result : group.m_batch->m_values)
+            {
+                // Reset/recovery may wait; ordinary polling and cancellation do
+                // not. Async copy queues are independent of frame submission.
+                SectorUploadsComplete(*result, true);
+                ReleaseSectorUploads(*result);
+            }
+        m_deferredGroups.clear();
     }
 
