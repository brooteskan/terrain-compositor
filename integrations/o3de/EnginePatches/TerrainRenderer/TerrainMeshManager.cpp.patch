+    void TerrainMeshManager::BeginBoundedRecovery(const SectorUpdatePlan& plan, AZ::Vector3 position)
+    {
+        ++m_recoveryEpoch;
+        m_recoveryPlan = plan;
+        m_recoveryActive = true;
+        m_recoveryStartedUs = SectorTimestampUs();
+        m_firstRecoveryCoverageUs = HasRecoveryCoverage(position) ? m_recoveryStartedUs : 0;
+        m_recoveryCoverageMiss = m_recoveryRefinementMiss = false;
+        AZStd::stable_sort(m_recoveryPlan.m_placements.begin(), m_recoveryPlan.m_placements.end(),
+            [&](const auto& a, const auto& b)
+            {
+                if (a.m_lod != b.m_lod) return a.m_lod > b.m_lod;
+                const float meters = m_gridSize * m_sampleSpacing * float(1 << a.m_lod);
+                const AZ::Vector2 camera(position.GetX(), position.GetY());
+                return ((AZ::Vector2(float(a.m_coordinate.m_x), float(a.m_coordinate.m_y)) + AZ::Vector2(0.5f)) * meters).GetDistanceSq(camera) <
+                    ((AZ::Vector2(float(b.m_coordinate.m_x), float(b.m_coordinate.m_y)) + AZ::Vector2(0.5f)) * meters).GetDistanceSq(camera);
+            });
+        for (const auto& placement : m_recoveryPlan.m_placements)
+            m_sectorLods[placement.m_lod].m_sectors[placement.m_slot].m_deferredRetry = true;
+        if (r_terrainSectorUpdateTiming || r_terrainRecoveryTiming)
+            AZ_Printf("TerrainDispatch", "epoch=%zu event=recovery-begin pending=%zu plan-bytes=%zu\n", m_recoveryEpoch,
+                plan.m_placements.size(), m_recoveryPlan.m_placements.capacity() * sizeof(SectorPlacement));
+        if ((r_terrainSectorUpdateTiming || r_terrainRecoveryTiming) && m_firstRecoveryCoverageUs)
+            AZ_Printf("TerrainDispatch", "epoch=%zu event=first-coverage latency-us=0 retained=1\n", m_recoveryEpoch);
+    }
