+    bool TerrainMeshManager::HasRecoveryCoverage(AZ::Vector3 position) const
+    {
+        AZStd::vector<TerrainCompositor::TerrainSectorCoverageClaim> claims;
+        float distanceSq = m_config.m_firstLodDistance * m_config.m_firstLodDistance;
+        for (const auto& lod : m_sectorLods)
+        {
+            for (const auto& sector : lod.m_sectors)
+            {
+                const auto& committed = sector.m_committed;
+                if (!committed.m_valid || !TerrainCompositor::IsWithinTerrainCoverage(committed.m_hasData, committed.m_aabb, position, distanceSq)) continue;
+                claims.push_back({ committed.m_worldCoord.m_x, committed.m_worldCoord.m_y, committed.m_lodLevel, committed.m_hasData });
+            }
+            distanceSq *= 4;
+        }
+        const auto quadrantAt = [&](const auto& claim) -> unsigned
+        {
+            const float meters = m_gridSize * m_sampleSpacing * float(1 << claim.m_lod);
+            const float x = position.GetX() - claim.m_x * meters, y = position.GetY() - claim.m_y * meters;
+            if (x < 0 || y < 0 || x >= meters || y >= meters) return 0;
+            return 1u << (unsigned(x >= meters * 0.5f) + 2 * unsigned(y >= meters * 0.5f));
+        };
+        for (const auto& claim : claims) if (!claim.m_hasData && quadrantAt(claim)) return true;
+        const auto projection = TerrainCompositor::SelectTerrainSectorCoverage(claims, m_sectorLods.size());
+        for (const auto& draw : projection.m_draws)
+            if (draw.m_quadrants & quadrantAt(claims[draw.m_claim])) return true;
+        return false;
+    }
