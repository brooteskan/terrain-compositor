+    void TerrainMeshManager::ScheduleRecoveryUnit()
+    {
+        if (m_recoveryPlan.m_placements.empty()) return;
+        const auto lod = m_recoveryPlan.m_placements.front().m_lod;
+        // Complete each coarse level before admitting finer requests. Priority
+        // within the level is stable: every admitted unit retains its place.
+        for (const auto& group : m_deferredGroups)
+            if (!group.m_batch->m_cancelled && group.m_plan.m_placements.front().m_lod > lod) return;
+        SectorUpdatePlan unit;
+        unit.m_starts = m_recoveryPlan.m_starts;
+        for (const auto& placement : m_recoveryPlan.m_placements)
+        {
+            if (placement.m_lod != lod || unit.m_placements.size() == TerrainCompositor::TerrainRecoveryLimits::RequestsPerFrame) break;
+            unit.m_placements.push_back(placement);
+        }
+        if (!ScheduleSectorGroup(unit, true, true)) return;
+        for (const auto& placement : unit.m_placements)
+            m_sectorLods[placement.m_lod].m_sectors[placement.m_slot].m_deferredRetry = false;
+        m_recoveryPlan.m_placements.erase(m_recoveryPlan.m_placements.begin(),
+            m_recoveryPlan.m_placements.begin() + unit.m_placements.size());
+    }
