+    AZStd::vector<AZStd::vector<TerrainMeshManager::Sector*>> TerrainMeshManager::CollectUpdatedSectors(AZ::Vector3 position)
+    {
+        const auto plan = PlanSectorUpdates(position);
+        AZStd::vector<AZStd::vector<Sector*>> updates(m_sectorLods.size());
+        for (size_t lod = 0; lod < plan.m_starts.size(); ++lod) m_sectorLods[lod].m_startCoord = plan.m_starts[lod];
+        for (const auto& placement : plan.m_placements)
+        {
+            auto& sector = m_sectorLods[placement.m_lod].m_sectors[placement.m_slot];
+            RequestSectorPlacement(sector, placement.m_coordinate);
+            updates[placement.m_lod].push_back(&sector);
+        }
+        return updates;
+    }
