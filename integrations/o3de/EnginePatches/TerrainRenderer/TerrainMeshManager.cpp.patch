+    void TerrainMeshManager::CancelDeferredGroup(DeferredSectorGroup& group)
+    {
+        m_sectorDispatcher->Cancel(group.m_batch);
+        for (const auto& placement : group.m_plan.m_placements)
+        {
+            auto& sector = m_sectorLods[placement.m_lod].m_sectors[placement.m_slot];
+            if (auto flag = sector.m_pendingCancellation.lock(); flag && flag->load(std::memory_order_acquire))
+            {
+                sector.m_pendingCancellation.reset();
+                ++sector.m_preparationSerial;
+                sector.m_deferredRetry = group.m_due &&
+                    (!sector.m_committed.m_valid || sector.m_committed.m_worldCoord != sector.m_requestedWorldCoord);
+                SetSectorState(sector, sector.m_committed.m_valid && sector.m_committed.m_worldCoord == sector.m_requestedWorldCoord
+                    ? SectorState::Committed : SectorState::Requested);
+            }
+        }
+    }
