+    TerrainMeshManager::SectorUpdatePlan TerrainMeshManager::PlanSectorUpdates(AZ::Vector3 position) const
+    {
+        SectorUpdatePlan plan;
+        for (uint32_t lod = 0; lod < m_sectorLods.size(); ++lod)
+        {
+            const auto& grid = m_sectorLods[lod];
+            const float distance = m_config.m_firstLodDistance * float(1 << lod);
+            const float meters = m_gridSize * m_sampleSpacing * float(1 << lod);
+            const auto axis = [&](float p, int32_t previous)
+            {
+                const int32_t desired = aznumeric_cast<int32_t>(AZStd::floorf((p - distance) / meters));
+                return int64_t(desired) > int64_t(previous) + 1 ? desired - 1 : desired < previous ? desired : previous;
+            };
+            const Vector2i start(axis(position.GetX(), grid.m_startCoord.m_x), axis(position.GetY(), grid.m_startCoord.m_y));
+            plan.m_starts.push_back(start);
+            const auto wrap = [&](int32_t value) { return uint32_t((int64_t(value) % m_1dSectorCount + m_1dSectorCount) % m_1dSectorCount); };
+            for (uint32_t x = 0; x < m_1dSectorCount; ++x)
+                for (uint32_t y = 0; y < m_1dSectorCount; ++y)
+                {
+                    const size_t slot = ((wrap(start.m_y) + y) % m_1dSectorCount) * m_1dSectorCount +
+                        (wrap(start.m_x) + x) % m_1dSectorCount;
+                    const Vector2i coordinate = start + Vector2i(x, y);
+                    const auto& sector = grid.m_sectors[slot];
+                    if (sector.m_requestedWorldCoord != coordinate ||
+                        (sector.m_deferredRetry &&
+                            (!sector.m_committed.m_valid || sector.m_committed.m_worldCoord != coordinate)))
+                        plan.m_placements.push_back({ lod, slot, coordinate });
+                }
+        }
+        return plan;
+    }
