+    bool TerrainMeshManager::ScheduleSectorGroup(const SectorUpdatePlan& plan, bool due, bool boundedRecovery)
+    {
+        AZ_PROFILE_SCOPE(AzRender, "Terrain::CaptureSectorGroup");
+        m_scheduleUnsupported = false;
+        const auto unsupported = [&]() { m_scheduleUnsupported = true; return false; };
+        if (!r_terrainDeferredPreparation || !r_terrainRetainedOnlyQueries || plan.m_placements.empty()) return unsupported();
+        if (!m_sectorDispatcher)
+        {
+            AZ::JobManager* jobs = nullptr;
+            AZ::JobManagerBus::BroadcastResult(jobs, &AZ::JobManagerEvents::GetManager);
+            if (!jobs || jobs->GetNumWorkerThreads() < 3) return unsupported();
+            SectorDispatcher::Limits limits;
+            limits.m_bytes -= TerrainCompositor::TerrainRecoveryLimits::PlanBytes;
+            limits.m_workers = AZStd::min<size_t>(2, jobs->GetNumWorkerThreads() - 2);
+            m_sectorDispatcher = std::make_unique<SectorDispatcher>(limits);
+            m_deferredGroups.reserve(limits.m_groups);
+        }
+        // Conservative admission ledger covers each request's peak planning,
+        // gather/reuse scratch, packed/RT result and allocator/job overhead. A
+        // separate allowance retains bounded source/publication generations.
+        // The additional MiB per request reserves unpublished GPU payload plus
+        // transfer fences/views. The ledger covers queued and cancelled uploads too.
+        const size_t uploadDevices = r_terrainStageUploads ?
+            AZStd::max<size_t>(1, AZ::RHI::RHISystemInterface::Get()->GetDeviceCount()) : 0;
+        if (r_terrainBoundedRecovery && r_terrainStageUploads && !boundedRecovery &&
+            plan.m_placements.size() > TerrainCompositor::TerrainRecoveryLimits::RequestsPerFrame) return false;
+        const size_t bytes = plan.m_placements.size() * (2 + uploadDevices) * 1024 * 1024 + 32 * 1024 * 1024;
+        if (!m_sectorDispatcher->CanReserve(plan.m_placements.size(), bytes)) return false;
+        TerrainCompositor::TerrainMeshCutoutRenderChannelPtr channel;
+        if (auto* registry = AZ::Interface<TerrainCompositor::TerrainMeshCutoutRenderRegistry>::Get())
+            channel = registry->AcquireSceneChannel(m_parentScene);
+        const auto snapshot = channel ? channel->m_snapshot.load(std::memory_order_acquire) : nullptr;
+        if (!snapshot || m_gridVerts1D > 129 || snapshot->m_renderGeometryQueries.size() > 32) return unsupported();
+        size_t generationBytes = sizeof(*snapshot) + TerrainCompositor::Internal::CapacityBytes(snapshot->m_cutouts) +
+            TerrainCompositor::Internal::CapacityBytes(snapshot->m_meshHeightGaps) +
+            TerrainCompositor::Internal::CapacityBytes(snapshot->m_compositionGenerations) +
+            TerrainCompositor::Internal::CapacityBytes(snapshot->m_renderGeometryQueries);
+        for (const auto& query : snapshot->m_renderGeometryQueries)
+        {
+            if (!query.m_retainedBytes || query.m_retainedBytes > 16 * 1024 * 1024) return unsupported();
+            generationBytes += query.m_retainedBytes;
+        }
+        for (const auto& cutout : snapshot->m_cutouts) generationBytes += TerrainCompositor::Internal::RetainedBytes(cutout);
+        for (const auto& gap : snapshot->m_meshHeightGaps) generationBytes += TerrainCompositor::Internal::RetainedBytes(gap);
+        if (generationBytes > 16 * 1024 * 1024)
+        {
+            if (r_terrainSectorUpdateTiming) AZ_Printf("TerrainDispatch", "event=backpressure reason=generation-bytes bytes=%zu\n", generationBytes);
+            return unsupported();
+        }
+        const auto settings = CapturePreparationSettings();
+        auto commitGroup = std::make_shared<SectorCommitGroup>();
+        commitGroup->m_expectedResults = plan.m_placements.size();
+        commitGroup->m_boundedRecovery = boundedRecovery;
+        std::vector<std::shared_ptr<PreparedSectorResult>> pending;
+        std::vector<std::shared_ptr<std::atomic_bool>> cancellations;
+        pending.reserve(plan.m_placements.size());
+        cancellations.reserve(plan.m_placements.size());
+        bool eligible = true;
+        // Coarse prerequisites are dispatched first, still in one atomic group.
+        for (auto it = plan.m_placements.rbegin(); it != plan.m_placements.rend(); ++it)
+        {
+            auto& sector = m_sectorLods[it->m_lod].m_sectors[it->m_slot];
+            if (!sector.m_committed.m_srg) InitializeSectorResources(sector, it->m_lod);
+            auto result = std::make_shared<PreparedSectorResult>();
+            result->m_request = CaptureSectorRequest(it->m_lod, it->m_slot, settings, channel,
+                r_terrainSectorUpdateTiming, snapshot, commitGroup, &it->m_coordinate);
+            result->m_request.m_stageUploads = r_terrainStageUploads;
+            auto& sampling = result->m_request.m_samplingPlan;
+            sampling.m_queryPolicy = TerrainCompositor::TerrainSectorQueryPolicy::RetainedOnly;
+            sampling.m_schedulePolicy = TerrainCompositor::TerrainSectorSchedulePolicy::Deferred;
+            {
+                AZ_PROFILE_SCOPE(AzRender, "Terrain::AssessCapturedSector");
+                sampling.Assess();
+            }
+            eligible &= sampling.CanExecuteAcrossFrames() &&
+                (!boundedRecovery || TerrainCompositor::CertifyTerrainSectorSampling(sampling).m_proven);
+            cancellations.push_back(result->m_request.m_cancelled);
+            pending.push_back(AZStd::move(result));
+        }
+        if (!eligible)
+        {
+            for (const auto& cancellation : cancellations) cancellation->store(true, std::memory_order_release);
+            m_deferredRetryUs = SectorTimestampUs() + 250000;
+            return unsupported();
+        }
+        auto batch = m_sectorDispatcher->Submit(AZStd::move(pending), AZStd::move(cancellations), bytes, due);
+        if (!batch) return false;
+        const double now = SectorTimestampUs();
+        m_deferredGroups.push_back({ batch, plan, due, now, due ? now : 0.0, 0, 0, bool(r_terrainStageUploads), boundedRecovery });
+        if (r_terrainSectorUpdateTiming)
+        {
+            const auto accounting = m_sectorDispatcher->GetAccounting();
+            AZ_Printf("TerrainDispatch", "event=admit group=%zu sectors=%zu due=%d reserved-bytes=%zu peak-bytes=%zu groups=%zu workers=%zu\n",
+                batch->m_id, plan.m_placements.size(), due, accounting.m_reservedBytes, accounting.m_peakBytes, accounting.m_groups, accounting.m_running);
+        }
+        return true;
+    }
