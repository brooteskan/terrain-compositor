+    AZ::u32 TerrainMeshManager::AssessSectorSplit(const SectorPreparationRequest& a, const SectorPreparationRequest& b,
+        const TerrainCompositor::TerrainSectorCoverageSelection& proposedCoverage)
+    {
+        using Blocker = TerrainCompositor::TerrainSectorSplitBlocker;
+        auto blockers = TerrainCompositor::AssessTerrainSectorSplitSampling(a.m_samplingPlan, b.m_samplingPlan);
+        if (!a.m_data.m_settings || a.m_data.m_settings != b.m_data.m_settings) blockers |= static_cast<AZ::u32>(Blocker::Settings);
+        if (!proposedCoverage.IsRepresentable()) blockers |= static_cast<AZ::u32>(Blocker::Coverage);
+        // Coverage projection proves only representability. Matching shared raw
+        // heights/existence/normal halos, CLOD samples and retained neighbor inputs
+        // still need a certificate. No smaller production replacement is enabled.
+        return blockers | static_cast<AZ::u32>(Blocker::WholeGroupPolicy);
+    }
+
+    size_t TerrainMeshManager::GetSectorUploadBytes(AZStd::span<const std::shared_ptr<PreparedSectorResult>> results)
+    {
+        size_t bytes = 0;
+        for (const auto& result : results)
+            if (result && result->m_hasData)
+            {
+                bytes += result->m_heights.size() * sizeof(HeightNormalVertex);
+                if (result->m_request.m_data.m_settings && result->m_request.m_data.m_settings->m_clodEnabled)
+                    bytes += result->m_lodHeights.size() * sizeof(HeightNormalVertex);
+                if (result->m_request.m_rayTracing)
+                    bytes += (result->m_rtPositions.size() + result->m_rtNormals.size()) * sizeof(RtVertex);
+            }
+        return bytes; // Payload bytes, not an estimate of upload duration/driver work.
+    }
+
+    TerrainMeshManager::SectorWorkStorage TerrainMeshManager::GetSectorWorkStorage(
+        AZStd::span<const std::shared_ptr<PreparedSectorResult>> results)
+    {
+        SectorWorkStorage storage;
+        // Caller owns these entries or has joined their jobs. Never poll mutable
+        // result vectors concurrently. Shared retained objects are counted once.
+        std::set<const void*> sources, publications, settings;
+        for (const auto& result : results)
+            if (result)
+            {
+                const auto& request = result->m_request;
+                if (result->m_delivered)
+                {
+                    ++storage.m_completedResults;
+                    storage.m_completedCpuBytes += GetPreparedCpuBytes(*result);
+                }
+                else
+                {
+                    ++storage.m_pendingResults;
+                    storage.m_pendingCpuBytes += GetPreparedCpuBytes(*result);
+                }
+                if (request.m_samplingPlan.m_sources && sources.insert(request.m_samplingPlan.m_sources.get()).second)
+                {
+                    const auto& retained = *request.m_samplingPlan.m_sources;
+                    storage.m_retainedSourceBytes += sizeof(retained) +
+                        retained.m_queries.capacity() * sizeof(TerrainCompositor::TerrainRenderGeometryQuery) +
+                        retained.m_dependencies.capacity() * sizeof(TerrainCompositor::TerrainPreparationDependencyTicket);
+                }
+                if (request.m_samplingPlan.m_publication && publications.insert(request.m_samplingPlan.m_publication.get()).second)
+                {
+                    const auto& retained = *request.m_samplingPlan.m_publication;
+                    storage.m_retainedPublicationBytes += sizeof(retained) +
+                        retained.m_cutouts.capacity() * sizeof(TerrainCompositor::PreparedTerrainMeshCutout) +
+                        retained.m_meshHeightGaps.capacity() * sizeof(TerrainCompositor::PreparedTerrainMeshHeightGap) +
+                        retained.m_compositionGenerations.capacity() * sizeof(AZStd::pair<AZ::Uuid, AZ::u64>) +
+                        retained.m_renderGeometryQueries.capacity() * sizeof(TerrainCompositor::TerrainRenderGeometryQuery);
+                }
+                if (request.m_data.m_settings && settings.insert(request.m_data.m_settings.get()).second)
+                    storage.m_sharedSettingsBytes += sizeof(SectorPreparationSettings) +
+                        request.m_data.m_settings->m_vertexOrder.capacity() * sizeof(uint16_t) +
+                        request.m_data.m_settings->m_xyPositions.capacity() * sizeof(XYPosition);
+            }
+        storage.m_retainedSourceSets = sources.size();
+        storage.m_retainedPublications = publications.size();
+        return storage;
+    }
