+    bool TerrainMeshManager::SameSectorPlan(const SectorUpdatePlan& a, const SectorUpdatePlan& b)
+    {
+        if (a.m_placements.size() != b.m_placements.size()) return false;
+        for (size_t i = 0; i < a.m_placements.size(); ++i)
+            if (a.m_placements[i].m_lod != b.m_placements[i].m_lod || a.m_placements[i].m_slot != b.m_placements[i].m_slot ||
+                a.m_placements[i].m_coordinate != b.m_placements[i].m_coordinate) return false;
+        return true;
+    }
