+    void TerrainMeshManager::PumpSectorDispatcher()
+    {
+        if (!m_sectorDispatcher) return;
+        m_sectorDispatcher->Pump([](PreparedSectorResult& result) { result = PrepareSector(AZStd::move(result.m_request)); },
+            [](SectorDispatcher::Work work)
+            {
+                auto execute = [work = AZStd::move(work)]() { work(); };
+                using Job = AZ::JobFunction<decltype(execute)>;
+                static_assert(sizeof(Job) <= 512);
+                (aznew Job(execute, true, nullptr))->Start();
+            });
+    }
