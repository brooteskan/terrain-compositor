#pragma once

// Kept independent of SRGs so the exact production arithmetic can be tested on a GPU.
half TC_OverlapRamp16(half distance, half width)
{
    half t = saturate(distance / max(width, 0.00006103515625h));
    return t * t * (3.0h - 2.0h * t);
}

// Inputs are in canonical priority/key order. Missing sources have zero coverage.
// All renderers use the same XY-derived values; fragment Z and draw order are irrelevant.
half4 TC_OverlapWeights16(half4 heights, half4 coverage, uint count, half width, bool retained)
{
    half4 weights = half4(0, 0, 0, 0);
    if (!(width > 0) || !isfinite(width) || count > 4) return weights;
    coverage = saturate(coverage);
    [unroll] for (uint i = 0; i < 4; ++i)
        if (i >= count || !isfinite(heights[i]) || !isfinite(coverage[i])) { coverage[i] = 0; heights[i] = 0; }
    if (retained)
    {
        // Smooth exposed-envelope partition. Coverage gates occlusion too: a source entering
        // its footprint cannot suppress another source before its own weight becomes positive.
        [unroll] for (uint i = 0; i < 4; ++i)
        {
            half score = coverage[i];
            [unroll] for (uint j = 0; j < 4; ++j)
                if (i != j && coverage[j] > 0 && coverage[i] > 0)
                    score *= 1.0h - coverage[j] * TC_OverlapRamp16(heights[j] - heights[i], width);
            weights += half4(i == 0, i == 1, i == 2, i == 3) * score;
        }
    }
    else
    {
        half previousHeight = 0, mass = 0;
        [unroll] for (uint i = 0; i < 4; ++i)
        {
            if (coverage[i] <= 0) continue;
            // Ordered Replace still wins at either higher OR lower elevation. Only the local
            // contact band shares its appearance with the already composed lower-priority set.
            half proximity = mass > 0 ? 1.0h - TC_OverlapRamp16(abs(heights[i] - previousHeight), width) : 0;
            half alpha = coverage[i] * (1.0h - 0.5h * proximity);
            weights *= 1.0h - alpha;
            weights += half4(i == 0, i == 1, i == 2, i == 3) * alpha;
            half nextMass = mass * (1.0h - alpha) + alpha;
            previousHeight = (previousHeight * mass * (1.0h - alpha) + heights[i] * alpha) / max(nextMass, 0.00006103515625h);
            mass = nextMass;
        }
    }
    half total = dot(weights, half4(1, 1, 1, 1));
    return total > 0.00006103515625h ? weights / total : half4(0, 0, 0, 0);
}
