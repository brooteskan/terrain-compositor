#pragma once

float3 DecodeTerrainNormal(float2 normalXY)
{
    // SNORM quantization can put XY just outside the unit disk, including after
    // CLOD interpolation. Clamp before sqrt and normalize like the RT decoder.
    float normalZ = sqrt(max(0.0, 1.0 - dot(normalXY, normalXY)));
    return normalize(float3(normalXY, normalZ));
}
