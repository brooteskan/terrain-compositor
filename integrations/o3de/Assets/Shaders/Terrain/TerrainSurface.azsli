#pragma once

// Graph-defined material channels. Colors are linear working RGB
// (ACEScg), normals are world-space, and roughness is perceptually linear.
struct TerrainSurfaceChannels
{
    half3 baseColor; // RGBA16F color/roughness cache
    half3 normal;    // RGBA16F normal/metalness cache
    half roughness;
    half metalness;
    half specularFactor;
    half ambientOcclusion;
};

struct TerrainSurfaceContext
{
    float3 worldPosition; // meters
    float3 geometricNormal;
};

float3 TC_SafeNormal(float3 value, float3 fallback)
{
    float lengthSquared = dot(value, value);
    return all(isfinite(value)) && isfinite(lengthSquared) && lengthSquared > 1e-12
        ? value * rsqrt(lengthSquared) : fallback;
}

float TC_SurfaceFactor(float value, float fallback)
{
    return isfinite(value) ? saturate(value) : fallback;
}

half3 TC_SafeNormal16(half3 value, half3 fallback)
{
    half lengthSquared = dot(value, value);
    return all(isfinite(value)) && isfinite(lengthSquared) && lengthSquared > half(0.00006103515625)
        ? value * rsqrt(lengthSquared) : fallback;
}

half TC_SurfaceFactor16(half value, half fallback)
{
    return isfinite(value) ? saturate(value) : fallback;
}

TerrainSurfaceChannels TC_ValidateSurface(TerrainSurfaceChannels value, TerrainSurfaceContext context)
{
    // Do not clamp HDR/overbright working RGB to one.
    value.baseColor = all(isfinite(value.baseColor)) ? max(value.baseColor, half(0)) : half3(1, 1, 1);
    value.normal = TC_SafeNormal16(value.normal, TC_SafeNormal16(half3(context.geometricNormal), half3(0, 0, 1)));
    value.roughness = TC_SurfaceFactor16(value.roughness, half(1));
    value.metalness = TC_SurfaceFactor16(value.metalness, half(0));
    value.specularFactor = TC_SurfaceFactor16(value.specularFactor, half(0.5));
    value.ambientOcclusion = TC_SurfaceFactor16(value.ambientOcclusion, half(1));
    return value;
}
