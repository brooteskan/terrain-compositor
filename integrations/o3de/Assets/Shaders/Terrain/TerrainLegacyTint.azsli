#pragma once

// TG prototype: use the height already supplied by terrain as the tint input.
// The ground inspector controls strength through the shared terrain material.
float TGTerrainNoiseCorner(int2 cell)
{
    uint hash = asuint(cell.x) * 0x8da6b343u ^ asuint(cell.y) * 0xd8163841u ^ 1337u;
    hash = (hash ^ (hash >> 16)) * 0x7feb352du;
    hash = (hash ^ (hash >> 15)) * 0x846ca68bu;
    return float((hash ^ (hash >> 16)) & 0x00ffffffu) / 16777215.0;
}

float3 TGTerrainNoiseTint(float3 worldPosition)
{
    const float PatchSizeMeters = 64.0;
    float tintStrength = saturate(TerrainMaterialSrg::m_noiseTintStrength);
    const float HeightStartMeters = -3.0;
    const float HeightEndMeters = 3.0;

    float2 position = worldPosition.xy / PatchSizeMeters;
    int2 cell = int2(floor(position));
    float2 blend = frac(position);
    blend = blend * blend * blend * (blend * (blend * 6.0 - 15.0) + 10.0);
    float noise = lerp(
        lerp(TGTerrainNoiseCorner(cell), TGTerrainNoiseCorner(cell + int2(1, 0)), blend.x),
        lerp(TGTerrainNoiseCorner(cell + int2(0, 1)), TGTerrainNoiseCorner(cell + int2(1, 1)), blend.x),
        blend.y);

    // Filter unresolved noise to its mean, not to black or a camera-distance fade.
    float footprint = max(length(ddx(position)), length(ddy(position)));
    noise = lerp(noise, 0.5, smoothstep(0.5, 1.0, footprint));
    float heightWeight = smoothstep(HeightStartMeters, HeightEndMeters, worldPosition.z);
    // Multiplicative tint in the renderer's working color space.
    return lerp(float3(1.0, 1.0, 1.0), float3(0.70, 0.85, 0.55), tintStrength * heightWeight * noise);
}
