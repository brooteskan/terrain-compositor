#pragma once

#include <Atom/Features/SrgSemantics.azsli>

#define SINGLE_MATERIAL_MAX_SAMPLERS 4
#define SINGLE_MATERIAL_MAX_TEXTURES 6

ShaderResourceGroup TerrainMaterialSrg : SRG_PerMaterial
{
    struct MeshCutout
    {
        float4 m_inverseRotation;
        float4 m_translationAndInverseScale;
        float4 m_localBoundsMinAndMargin;
        float4 m_localBoundsMax;
        uint m_firstIndex;
        uint m_indexCount;
        uint m_operation;
        uint m_padding;
    };

    struct MeshHeightGap
    {
        float4 m_worldBounds;
        float4 m_originAndRotation;
        float4 m_gridOriginAndInverseSpacing;
        float4 m_inverseScaleAndDomainMax;
        uint m_cellWidth;
        uint m_cellHeight;
        uint m_maskOffset;
        uint m_tileOffset;
        uint m_tileWidth;
        uint m_revisionLow;
        uint m_revisionHigh;
        uint m_padding;
    };

    // Immutable mesh-cutout publication. Buffers are rebuilt only when the snapshot revision changes.
    uint m_meshCutoutCount;
    // Material-connected publication revision. Its value is not shaded; changing it dirties the material SRG.
    uint m_meshCutoutRevision;
    StructuredBuffer<MeshCutout> m_meshCutouts;
    StructuredBuffer<float4> m_meshCutoutVertices;
    StructuredBuffer<uint> m_meshCutoutIndices;
    uint m_meshHeightGapCount;
    uint m_meshHeightGapRevision;
    StructuredBuffer<MeshHeightGap> m_meshHeightGaps;
    StructuredBuffer<uint> m_meshHeightGapWords;
#ifdef TC_GRAPH_MATERIAL
    MaterialParameters m_params;
    // fallback texture index for GetMaterialTexture() in case the texture index is negative.
    int m_nullTextureIndex;
#ifdef AZ_TRAIT_SINGLE_MATERIAL_USE_TEXTURE_ARRAY
    // the MaterialParameters - struct can only contain texture indices, and no Texture2D directly.
    // if we can't use the bindless SRG at all, we register the Textures in this fixed-size array, and the texture-indices refer to this array
    Texture2D m_textures[SINGLE_MATERIAL_MAX_TEXTURES];
#endif

#ifdef AZ_TRAITS_MATERIALS_USE_SAMPLER_ARRAY
    // sampler 0 is the default linear clamp sampler, the others are initialized by the MaterialSystem as needed
    Sampler m_samplers[SINGLE_MATERIAL_MAX_SAMPLERS];
#else
    Sampler m_defaultSampler
    {
        AddressU = Wrap;
        AddressV = Wrap;
        MinFilter = Linear;
        MagFilter = Linear;
        MipFilter = Linear;
        MaxAnisotropy = 16;
    };
#endif
#endif
}

#ifdef TC_GRAPH_MATERIAL
#ifndef AZ_TRAIT_SINGLE_MATERIAL_USE_TEXTURE_ARRAY
#include <Atom/Features/Bindless.azsli>
#endif

Texture2D GetMaterialTexture(const int readIndex)
{
    int localReadIndex = readIndex;
    if (localReadIndex < 0)
    {
        localReadIndex = TerrainMaterialSrg::m_nullTextureIndex;
    }
#ifdef AZ_TRAIT_SINGLE_MATERIAL_USE_TEXTURE_ARRAY
    if (localReadIndex >= SINGLE_MATERIAL_MAX_TEXTURES)
    {
        localReadIndex = TerrainMaterialSrg::m_nullTextureIndex;
    }
    return TerrainMaterialSrg::m_textures[localReadIndex];
#else
    return Bindless::GetTexture2D(localReadIndex);
#endif
}

const MaterialParameters GetMaterialParameters()
{
    return TerrainMaterialSrg::m_params;
}

// All MaterialProperties of the material with the type TextureSampler are collected and stored in the TerrainMaterialSrg::m_samplers array.
// The Shader - Parameter in the m_params - struct is then the samplerIndex.
// Note that the size of m_samplers is limited to SINGLE_MATERIAL_MAX_SAMPLERS, but samplers are deduplicated based on their settings,
// so this should be enough.
// Sampler-Index 0 is always the default Wrap - sampler with linear filtering.
sampler GetMaterialTextureSampler(const uint samplerIndex = 0)
{
#ifdef AZ_TRAITS_MATERIALS_USE_SAMPLER_ARRAY
    int localIndex = samplerIndex;
    if (samplerIndex >= SINGLE_MATERIAL_MAX_SAMPLERS)
    {
        localIndex = 0;
    }
    return TerrainMaterialSrg::m_samplers[localIndex];
#else
    return TerrainMaterialSrg::m_defaultSampler;
#endif
}


#endif
