#include <Atom/Features/SrgSemantics.azsli>
#include <scenesrg_all.srgi>
#include <viewsrg_all.srgi>
#include <TerrainCommon.azsli>
#include <TerrainMeshCutout.azsli>

struct VSDepthOutput
{
    // SV_Depth must preserve each MSAA sample's rasterized depth. Pixel-frequency
    // depth would make the later forward pass reject samples on sloped terrain.
    sample float4 m_position : SV_Position;
    float3 m_worldPosition : UV0;
};

VSDepthOutput MainVS(in VertexInput input)
{
    VSDepthOutput output;

    float3 normal; // ignored

    CalculateTerrainPosition(
        SceneSrg::m_terrainWorldData, ObjectSrg::m_patchData, input, // input params
        output.m_worldPosition, output.m_position, normal // output params
        );

    return output;
}

struct PSDepthOutput
{
    precise float m_depth : SV_Depth;
};

PSDepthOutput MainPS(VSDepthOutput input)
{
    if (TGMeshCutoutDiscardsTerrain(input.m_worldPosition))
    {
        discard;
    }

    // Match Atom's clipped depth shaders: expose a depth-only output contract
    // and preserve the rasterized depth for every fragment that survives.
    PSDepthOutput output;
    output.m_depth = input.m_position.z;
    return output;
}
