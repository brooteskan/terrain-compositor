#pragma once

#include <Atom/Features/SrgSemantics.azsli>

ShaderResourceGroupSemantic SRG_Terrain
{
    FrequencyId = 3;
};

ShaderResourceGroup TerrainSrg : SRG_Terrain
{
    struct MeshData
    {
        float3 m_mainCameraPosition;
        float m_firstLodDistance;
        float m_rcpClodDistance;
        float m_rcpGridSize;
        float m_gridToQuadScale;
        [[pad_to(16)]]
    };

    MeshData m_meshData;
    // Material appearance cache. Geometry/CLOD state above is unchanged.
    float4 m_graphCacheMappings[5];
    float4 m_graphCacheTileTags[5];
    uint m_graphCacheToroidal;
    uint m_graphCacheEnabled;
    uint m_graphCacheDebug;
    Texture2D<float4> m_graphCacheColor[5];
    Texture2D<float4> m_graphCacheNormal[5];
    Texture2D<float4> m_graphCacheFactors[5];
    Texture2D<float4> m_graphCacheGeometry[5];
    SamplerState m_graphCacheSampler
    {
        MinFilter = Linear;
        MagFilter = Linear;
        MipFilter = Point;
        AddressU = Wrap;
        AddressV = Wrap;
    };


    float CalculateClodDistance(uint lodLevel, float3 worldPosition)
    {
        float maxRange = m_meshData.m_firstLodDistance * float(1u << lodLevel);
        float viewDistanceToWorldPosition = length(m_meshData.m_mainCameraPosition - worldPosition);
        return maxRange - viewDistanceToWorldPosition;
    }
}
