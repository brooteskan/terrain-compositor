{
  "description": "Vue baked terrain with world-space clipping against the infinite ground plane.",
  "functors": [
    {
      "args": {
        "file": "Assets/VueLiveLink/VueTerrainMesh_State.lua"
      },
      "type": "Lua"
    }
  ],
  "lightingModel": "Standard",
  "materialShaderCode": "VueTerrainMesh.azsli",
  "materialShaderDefines": "VueTerrainOverlap_Defines.azsli",
  "propertyLayout": {
    "propertyGroups": [
      {
        "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/BaseColorPropertyGroup.json"
      },
      {
        "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/VertexColorPropertyGroup.json"
      },
      {
        "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/MetallicPropertyGroup.json"
      },
      {
        "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/RoughnessPropertyGroup.json"
      },
      {
        "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/SpecularPropertyGroup.json"
      },
      {
        "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/NormalPropertyGroup.json"
      },
      {
        "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/OcclusionPropertyGroup.json"
      },
      {
        "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/EmissivePropertyGroup.json"
      },
      {
        "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/ClearCoatPropertyGroup.json"
      },
      {
        "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/ParallaxPropertyGroup.json"
      },
      {
        "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/OpacityPropertyGroup.json"
      },
      {
        "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/UvPropertyGroup.json"
      },
      {
        "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/IrradiancePropertyGroup.json"
      },
      {
        "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/GeneralCommonPropertyGroup.json"
      },
      {
        "$import": "@gemroot:Atom_Feature_Common@/Assets/Materials/Types/MaterialInputs/SilhouetteBlockerPropertyGroup.json"
      },
      {
        "displayName": "Ground Contact",
        "name": "groundContact",
        "properties": [
          {
            "connection": {
              "name": "m_vueGroundHeight",
              "type": "ShaderInput"
            },
            "defaultValue": 0.0,
            "description": "World Z of the flat infinite ground, in meters.",
            "displayName": "Ground Height",
            "name": "height",
            "type": "Float"
          },
          {
            "connection": {
              "name": "m_vueGroundTolerance",
              "type": "ShaderInput"
            },
            "defaultValue": 0.001,
            "description": "Clip terrain at or below ground height plus this distance, in meters.",
            "displayName": "Contact Tolerance",
            "min": 0.0,
            "name": "tolerance",
            "type": "Float"
          }
        ]
      },
      {
        "displayName": "Terrain Normal Smoothing",
        "name": "normalSmoothing",
        "properties": [
          {
            "connection": {
              "name": "m_vueNormalField",
              "type": "ShaderInput"
            },
            "description": "Generated during terrain baking; paired with Generated Grid Size. Read-only.",
            "displayName": "Generated Normal Field",
            "name": "field",
            "type": "Image"
          },
          {
            "connection": {
              "name": "m_vueNormalGridSize",
              "type": "ShaderInput"
            },
            "defaultValue": [
              2,
              2
            ],
            "description": "Actual sample count in the generated normal field, not a smoothing or resolution control. Read-only.",
            "displayName": "Generated Grid Size",
            "name": "gridSize",
            "type": "Vector2"
          },
          {
            "connection": {
              "name": "m_vueNormalSmoothing",
              "type": "ShaderInput"
            },
            "defaultValue": 0.0,
            "description": "Bicubic terrain normals. Zero restores the original interpolated mesh normals; one uses the smooth field. Does not move geometry.",
            "displayName": "Smoothing Strength",
            "max": 1.0,
            "min": 0.0,
            "name": "strength",
            "type": "Float"
          }
        ]
      },
      {
        "$import": "VueResponsePropertyGroup.json"
      },
      {
        "displayName": "Ground Material Transition",
        "name": "groundBlend",
        "properties": [
          {
            "connection": {
              "name": "m_vueBlendHeight",
              "type": "ShaderInput"
            },
            "defaultValue": 0.0,
            "description": "World height above the clipped ground contact over which terrain fades into the ground material. Zero disables blending.",
            "displayName": "Transition Height",
            "min": 0.0,
            "name": "height",
            "type": "Float"
          },
          {
            "connection": {
              "name": "m_vueBlendColorTexture",
              "type": "ShaderInput"
            },
            "displayName": "Ground Color Map",
            "name": "colorTexture",
            "type": "Image"
          },
          {
            "connection": {
              "name": "m_vueBlendNormalTexture",
              "type": "ShaderInput"
            },
            "displayName": "Ground Normal Map",
            "name": "normalTexture",
            "type": "Image"
          },
          {
            "connection": {
              "name": "m_vueBlendTextureScale",
              "type": "ShaderInput"
            },
            "defaultValue": 1000.0,
            "displayName": "Ground Texture World Size",
            "name": "textureScale",
            "type": "Float"
          },
          {
            "connection": {
              "name": "m_vueBlendStochastic",
              "type": "ShaderInput"
            },
            "defaultValue": true,
            "displayName": "Ground Stochastic Tiling",
            "name": "stochastic",
            "type": "Bool"
          },
          {
            "connection": {
              "name": "m_vueBlendNormalStrength",
              "type": "ShaderInput"
            },
            "defaultValue": 1.0,
            "displayName": "Ground Normal Strength",
            "name": "normalStrength",
            "type": "Float"
          },
          {
            "connection": {
              "name": "m_vueBlendColorTint",
              "type": "ShaderInput"
            },
            "defaultValue": [
              1.0,
              1.0,
              1.0,
              1.0
            ],
            "displayName": "Ground Color Tint",
            "name": "colorTint",
            "type": "Color"
          },
          {
            "connection": {
              "name": "m_vueBlendRoughness",
              "type": "ShaderInput"
            },
            "defaultValue": 1.0,
            "displayName": "Ground Roughness",
            "name": "roughness",
            "type": "Float"
          },
          {
            "connection": {
              "name": "m_vueBlendSpecularFactor",
              "type": "ShaderInput"
            },
            "defaultValue": 0.5,
            "displayName": "Ground Specular Factor",
            "name": "specularFactor",
            "type": "Float"
          },
          {
            "connection": {
              "name": "m_vueBlendAmbientOcclusion",
              "type": "ShaderInput"
            },
            "defaultValue": 1.0,
            "displayName": "Ground AO",
            "name": "ambientOcclusion",
            "type": "Float"
          },
          {
            "connection": {
              "name": "m_vueBlendDirectGain",
              "type": "ShaderInput"
            },
            "defaultValue": 1,
            "displayName": "Ground directGain",
            "name": "directGain",
            "type": "Float"
          },
          {
            "connection": {
              "name": "m_vueBlendAmbientGain",
              "type": "ShaderInput"
            },
            "defaultValue": 1,
            "displayName": "Ground ambientGain",
            "name": "ambientGain",
            "type": "Float"
          },
          {
            "connection": {
              "name": "m_vueBlendAlbedoScale",
              "type": "ShaderInput"
            },
            "defaultValue": 1,
            "displayName": "Ground albedoScale",
            "name": "albedoScale",
            "type": "Float"
          },
          {
            "connection": {
              "name": "m_vueBlendSpecularGain",
              "type": "ShaderInput"
            },
            "defaultValue": 1,
            "displayName": "Ground specularGain",
            "name": "specularGain",
            "type": "Float"
          },
          {
            "connection": {
              "name": "m_vueBlendContrast",
              "type": "ShaderInput"
            },
            "defaultValue": 1,
            "displayName": "Ground contrast",
            "name": "contrast",
            "type": "Float"
          },
          {
            "connection": {
              "name": "m_vueBlendBacklight",
              "type": "ShaderInput"
            },
            "defaultValue": 0,
            "displayName": "Ground backlight",
            "name": "backlight",
            "type": "Float"
          }
        ]
      },
